{% set class= (class is defined ? class : '') %}
{% set use_quickview = (use_quickview is defined ? use_quickview : false) %}

{# Florian redesign productkaart (.fh-prod) — gedeeld door collectie, gerelateerde producten, enz.
   Styling: scss/_florian-redesign.scss #}
<article class="fh-prod {{class}}">
    <a href="{{ product.url }}" class="fh-prod-media" title="{{ product.name }}">
        <div class="fh-prod-ph">
            {% if product.has_discount %}
                <span class="fh-badge">{{ "Aanbieding"|t }}</span>
            {% endif %}
            <img src="{{ product.image_default.thumbs.400|image({"w": 400, "h": 400}) }}" alt="{{ "Foto van"|t }} {{ product.name }}" title="{{ product.name }}" loading="lazy"/>
        </div>
    </a>
    <div class="fh-prod-body">
        <a href="{{ product.url }}" title="{{ product.name }}"><h3>{{ product.name }}</h3></a>

        {% if product.price > 0 %}
            {% set price_excl = product.price / 1.21 %}
            <div class="fh-price-row">
                <div class="fh-price-wrap">
                    {% if product.has_discount %}
                        <s class="fh-old-price">&euro; {{ product.original_price|price(true, '') }}</s>
                    {% endif %}
                    <span class="fh-price">&euro;&thinsp;{{ product.price|price(true, '') }}</span>
                    <span class="fh-excl">&euro; {{ price_excl|price(true, '') }} excl. btw</span>
                </div>

                {# Bestellen via WhatsApp (winkelwagen komt later) #}
                {% if not product.available %}
                    <span class="fh-add fh-wa-add is-disabled" aria-label="{{ 'Uitverkocht'|t }}">
                        <svg class="fh-wa-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2zm4.52 12.99c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.77-1.84-.2-.48-.41-.42-.56-.43l-.48-.01c-.16 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.16 1.75 2.67 4.25 3.74.59.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg>
                    </span>
                {% else %}
                    {% set wa_card = "Hallo! Ik wil graag bestellen: " ~ product.name ~ (product.sku ? " (art.nr: " ~ product.sku ~ ")" : "") %}
                    <a class="fh-add fh-wa-add" href="https://wa.me/31850604129?text={{ wa_card|url_encode }}" target="_blank" rel="noopener" aria-label="{{ 'Bestellen via WhatsApp'|t }}">
                        <svg class="fh-wa-ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2zm4.52 12.99c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.77-1.84-.2-.48-.41-.42-.56-.43l-.48-.01c-.16 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.16 1.75 2.67 4.25 3.74.59.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg>
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
</article>
