<div class="row brands slider">
    <div class="col-md-9">
        <div class="brand-slider swiper">
            <div class="swiper-wrapper">
                {% for slide in slider.slides %}
                    <div class="text-center swiper-slide">
                        <a href="/merken/{{slide.title}}" class="brand-link" title="{{'logo van het merk [merknaam]'|t({"[merknaam]": slide.title})}}">
                            <img data-src="{{slide.filename|replace({"1170x250/" : ""})|image({"h": 50})}}" class="icon-h-50 lazyload" alt="{{'logo van het merk [merknaam]'|t({"[merknaam]": slide.title})}}">
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <a href="{{more_url}}" class="btn btn-primary">{{more_btn|t}}</a>
    </div>
</div>