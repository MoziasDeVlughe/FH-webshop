<nav id="mobile-menu-container" class="visible-xs visible-sm" style="opacity: 0" data-search-url="{{search_url}}">
    <ul>
        {% if not menu %}
            <li>
                <a>
                    <strong>
                        No menu defined for 'mmenu' macro
                    </strong>
                </a>
            </li>
        {% else %}
            {% for menuitem in menu.items %}
                <li class="{% if menuitem.active %} selected{% endif %} {% if loop.last %} no-border{% endif %}">
                    <a data-af-href="{{menuitem.url}}" title="{{menuitem.title}}">{{menuitem.label}}</a>
                    {% if menuitem.items %}
                        <ul class="vertical">
                            {% for subitem in menuitem.items %}
                                {% if subitem.url == "divider" %}
                                    <li class="mm-divider">
                                            {{subitem.label}}
                                    </li>
                                {% else %}
                                    <li>
                                        <a data-af-href="{{subitem.url}}" title="{{subitem.title}}">{{subitem.label}}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        {% endif %}
    </ul>
</nav>
