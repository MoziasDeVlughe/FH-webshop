<div class="container pt-20">
    <div class="wishlist-top-row">
        <h1>
            {{"WISHLIST"|t}}
        </h1>
        <form action="{{notification_url}}" id="toggle-notify" method="GET" class="hidden">
            <div class="checkbox af">
                <input type="checkbox" name="wishlist-notification" id="notify" {% if sent_notifications %} checked="checked" {% endif %}>
            </div>
        </form>
        <div class="btn-toolbar" role="tooblar">
            <div class="btn-group">
                <label for="notify" class="btn btn-sm btn-{% if sent_notifications %}success{% else %}danger{% endif %}">
                    <i class="fa fa-{% if sent_notifications %}check{% else %}times{% endif %}"> </i>
                    {{"Meldingen"|t}}
                </label>
            </div>
            <div class="btn-group">
                <a class="btn btn-sm btn-primary" data-toggle="modal" data-target="#social-options">
                    <i class="fa fa-lg fa-share-alt"> </i>&nbsp;
                    <span>{{"Deel"|t}}</span>
                </a>
            </div>
            <div class="btn-group">
                <form action="{{home_url}}cart/add-multiple" method="POST" id="wishlist-to-cart-form">
                    {% for listitem in items if listitem.product.stock > 0 %}
                        {% set product = listitem.product %}
                        <input type="hidden" name="item[{{loop.index0}}][quantity]" value="1">
                        <input type="hidden" name="item[{{loop.index0}}][price]" value="{{product.price}}">
                        <input type="hidden" name="item[{{loop.index0}}][product_id]" value="{{product.id}}">
                    {% endfor %}
                    <button class="btn btn-primary btn-sm" type="submit">
                        {{"Alles toevoegen"|t}}
                    </button>
                </form>
            </div>
        </div>
    </div>
    <hr />
    <div class="row wishlist-grid">
        {% for listitem in items %}
            {% set product = listitem.product %}
            <div class="col-xs-12 col-sm-6 wishlist-grid-item">
                <div class="wishlist-grid-item-inner panel panel-primary panel-body">
                    <div class="wishlist-grid-item-image">
                        <a data-af-href="{{product.url}}" class="thumbnail">
                            <div class="lazyload-wrapper lazyload-square">
                                <img class="lazyload" data-src="{{ product.images|first.thumbs.100|image({"w": 100, "h": 100}) }}" alt="{{ product.name }}">
                            </div>
                        </a>
                    </div>
                    <div class="wishlist-grid-item-info">
                        <div class="wishlist-grid-item-info-inner">
                            <span class="product-name"><a data-af-href="{{product.url}}">{{product.name}}</a></span>
                            <br>
                            <a class="fa fa-times pull-right" data-af-href="{{listitem.remove_url}}"></a>
                            <div class="wishlist-grid-item-info-table">
                                <div class="wishlist-table-row">
                                    <div class="wishlist-table-value">
                                        {% if product.has_discount %}
                                            <small>
                                                <s>{{ product.original_price|price }}</s>
                                            </small> &nbsp;
                                        {% endif %}
                                        <strong class="{% if product.has_discount %}text-danger{% endif %}">
                                            {{ product.price|price }}
                                        </strong>
                                    </div>
                                </div>
                                <div class="wishlist-table-row">
                                    {{product.short_description}}
                                </div>
                            </div>
                        </div>
                        <div class="wishlist-grid-item-info-actions">
                            {% if product.stock > 0 %}
                                <form action="{{ cart_url }}" method="post" id="add-product-{{product.id}}" class="wishlist-product-form" data-cart-url="{{home_url}}cart" data-product-url="{{url}}">
                                    <input type="hidden" value="{{ product.id }}" name="product_id"/>
                                    <input type="hidden" value="{{ product.sku }}" name="sku"/>
                                    <input type="hidden" value="1" name="quantity"/>
                                    <button class="btn btn-sm btn-primary" type="submit">
                                        <i class="fa fa-shopping-cart fa-lg"> </i> &nbsp;
                                        <i class="fa fa-plus fa-lg"> </i> 
                                        {#{{"In winkelwagen"|t}}#}
                                    </button>
                                </form>
                            {% else %}
                                <i class="text-danger">
                                    {{"Dit product is helaas niet op voorraad"|t}}
                                </i>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
    
<div class="modal fade" id="social-options" tabindex="-1" role="dialog" aria-labelledby="social-modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="social-modal">{{"Leuk dat je deze Wensenlijst wilt delen!"|t}}</h4>
            </div>
            <div class="modal-body text-center">
                <div class="row">
                    <div class="col-md-3 col-xs-6 col-sm-push-3">
                        <a class="text-primary" data-af-href="https://www.facebook.com/sharer/sharer.php?u={{share_url}}&t=" target="_blank" title="Share on Facebook" >
                            <i class="fab fa-4x fa-facebook"></i>
                            <br>
                            {{"Facebook"|t}}
                        </a>
                    </div>
                    <div class="col-md-3 col-xs-6 visible-xs visible-sm">
                        <a class="text-primary" data-af-href="whatsapp://send?text={{share_url}}">
                            <i class="fab fa-4x fa-whatsapp"></i>
                            <br>
                            {{"WhatsApp"|t}}
                        </a>
                    </div>
                    <div class="col-md-3 col-xs-6 col-sm-push-3">
                        <a class="text-primary" data-af-href="mailto:?subject=&body={{share_url}}" target="_self" title="Send email">
                            <i class="fa fa-4x fa-envelope"></i>
                            <br>
                            {{"Email"|t}}
                        </a>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                {{"Kopieer deze link op op je website te plaatsen of om te gebruiken in een bericht"|t}}
                <div class="form-group">
                    <div class="input-group">
                        <input class="form-control" value="{{share_url}}" readonly id="copy-field">
                        <div class="input-group-btn">
                            <button type="button" class="copy-to-clipboard btn btn-primary-inverse" data-clipboard-target="#copy-field" data-toggle="tooltip" data-placement="bottom" title="Gekopieerd!">{{"Kopieer"|t}}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>