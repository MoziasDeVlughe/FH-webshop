<div class="fh-collection fh-locator">
  <div class="container mt-24">
    <div class="title-row">
      <h1>{{title}}</h1>
    </div>
    <hr />

    {# De CMS-body wordt bewust NIET getoond: die dupliceerde de titel.
       Wil je later een intro-tekst tonen, zet 'm hieronder terug:
       {% if content is not empty %}<div class="fh-prose fh-locator__intro">{{content}}</div>{% endif %} #}

    <form id="locator-form" class="fh-locator__search" role="search" autocomplete="off">
      <label for="locator-input" class="sr-only">{{'Postcode of plaats'|t}}</label>
      <div class="fh-locator__searchbar">
        <div class="fh-locator__field">
          <i data-lucide="search" class="size-20 fh-locator__searchicon"></i>
          <input type="text" id="locator-input" name="q"
                 placeholder="{{'Postcode of plaats…'|t}}" />
        </div>
        <button type="submit" class="btn btn-primary fh-locator__submit">{{'Zoek'|t}}</button>
      </div>
      <button type="button" id="locator-geo" class="fh-locator__geo">
        <i data-lucide="locate-fixed" class="size-16"></i> {{'Gebruik mijn locatie'|t}}
      </button>
      <p id="locator-status" class="fh-locator__status" role="status" aria-live="polite"></p>
    </form>

    <div class="fh-locator__layout">
      <div class="fh-locator__list" id="locator-list">
        <ul class="fh-locator__items" id="locator-items"></ul>
        <p class="fh-locator__empty" id="locator-empty" hidden>{{'Geen verkooppunten gevonden.'|t}}</p>
      </div>
      <div class="fh-locator__map" id="locator-map"></div>
    </div>
  </div>
</div>{# /.fh-locator #}

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
  function init() {
    if (typeof L === 'undefined') { return; }

    var dataEl = document.getElementById('florian-dealers');
    var dealers = [];
    try { dealers = JSON.parse(dataEl.textContent) || []; } catch (e) { dealers = []; }
    // Alleen dealers met geldige coördinaten tonen op de kaart.
    dealers = dealers.filter(function (d) { return typeof d.lat === 'number' && typeof d.lng === 'number'; });

    var itemsEl  = document.getElementById('locator-items');
    var emptyEl  = document.getElementById('locator-empty');
    var statusEl = document.getElementById('locator-status');
    var inputEl  = document.getElementById('locator-input');
    var formEl   = document.getElementById('locator-form');
    var geoBtn   = document.getElementById('locator-geo');

    var map = L.map('locator-map', { scrollWheelZoom: false }).setView([52.15, 5.4], 7);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    var youMarker = null;

    function haversine(a, b, c, d) {
      var R = 6371, r = Math.PI / 180;
      var dLat = (c - a) * r, dLng = (d - b) * r;
      var s = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(a * r) * Math.cos(c * r) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
      return R * 2 * Math.atan2(Math.sqrt(s), Math.sqrt(1 - s));
    }

    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

    // Markers + popups opbouwen.
    dealers.forEach(function (d, i) {
      var route = 'https://www.google.com/maps/dir/?api=1&destination=' + d.lat + ',' + d.lng;
      var html = '<strong>' + esc(d.name) + '</strong><br>' +
        (d.street ? esc(d.street) + '<br>' : '') +
        esc([d.postal, d.city].filter(Boolean).join('  ')) + '<br>' +
        (d.phone ? '<a href="tel:' + esc((d.tel || d.phone).replace(/\s/g, '')) + '">' + esc(d.phone) + '</a><br>' : '') +
        (d.email ? '<a href="mailto:' + esc(d.email) + '">' + esc(d.email) + '</a><br>' : '') +
        (d.website ? '<a href="' + esc(d.website) + '" target="_blank" rel="noopener">Website</a> · ' : '') +
        '<a href="' + route + '" target="_blank" rel="noopener">Route</a>';
      d._marker = L.marker([d.lat, d.lng]).addTo(map).bindPopup(html);
      d._marker.on('click', function () { highlight(i); });
    });

    function highlight(i) {
      var lis = itemsEl.querySelectorAll('.fh-locator__item');
      for (var k = 0; k < lis.length; k++) { lis[k].classList.remove('is-active'); }
      var target = itemsEl.querySelector('[data-idx="' + i + '"]');
      if (target) {
        target.classList.add('is-active');
        target.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    // Lijst renderen. `list` bevat objecten {d, dist?} in de gewenste volgorde.
    function render(list) {
      itemsEl.innerHTML = '';
      emptyEl.hidden = list.length > 0;
      list.forEach(function (row) {
        var d = row.d, i = dealers.indexOf(d);
        var li = document.createElement('li');
        li.className = 'fh-locator__item';
        li.setAttribute('data-idx', i);
        var dist = (typeof row.dist === 'number')
          ? '<span class="fh-locator__dist">' + row.dist.toFixed(1) + ' km</span>' : '';
        var contact = '';
        if (d.phone || d.email) {
          contact = '<div class="fh-locator__contact">' +
            (d.phone ? '<a href="tel:' + esc((d.tel || d.phone).replace(/\s/g, '')) + '"><i data-lucide="phone"></i>' + esc(d.phone) + '</a>' : '') +
            (d.email ? '<a href="mailto:' + esc(d.email) + '"><i data-lucide="mail"></i>' + esc(d.email) + '</a>' : '') +
          '</div>';
        }
        li.innerHTML =
          '<div class="fh-locator__item-head"><span class="fh-locator__name">' + esc(d.name) + '</span>' + dist + '</div>' +
          '<div class="fh-locator__addr">' +
            (d.street ? esc(d.street) + ', ' : '') + esc([d.postal, d.city].filter(Boolean).join(' ')) +
          '</div>' +
          contact;
        li.addEventListener('click', function (e) {
          // klik op tel/mailto-link mag de kaart niet laten verspringen
          if (e.target.closest('a')) { return; }
          map.setView([d.lat, d.lng], 13);
          d._marker.openPopup();
          highlight(i);
        });
        itemsEl.appendChild(li);
      });
      // nieuw toegevoegde data-lucide iconen (tel/mail) omzetten naar SVG
      if (window.lucide && window.lucide.createIcons) { window.lucide.createIcons(); }
    }

    // Standaardvolgorde: alfabetisch op plaats, dan naam.
    function defaultOrder() {
      return dealers.slice().sort(function (a, b) {
        return (a.city || '').localeCompare(b.city || '') || (a.name || '').localeCompare(b.name || '');
      }).map(function (d) { return { d: d }; });
    }
    render(defaultOrder());

    // Sorteer op afstand vanaf een gegeven punt en zoom op de dichtstbijzijnde.
    function sortByDistance(lat, lng) {
      if (youMarker) { map.removeLayer(youMarker); }
      youMarker = L.circleMarker([lat, lng], {
        radius: 8, color: '#006633', weight: 2, fillColor: '#8bc63e', fillOpacity: 0.9
      }).addTo(map).bindPopup('Jouw locatie');

      var ranked = dealers.map(function (d) {
        return { d: d, dist: haversine(lat, lng, d.lat, d.lng) };
      }).sort(function (a, b) { return a.dist - b.dist; });

      render(ranked);

      var group = L.featureGroup([youMarker].concat(ranked.slice(0, 3).map(function (r) { return r.d._marker; })));
      map.fitBounds(group.getBounds().pad(0.25));

      if (ranked.length) {
        statusEl.textContent = 'Dichtstbijzijnde: ' + ranked[0].d.name + ' (' + ranked[0].dist.toFixed(1) + ' km).';
        highlight(dealers.indexOf(ranked[0].d));
      }
    }

    // Live filteren op naam/plaats/postcode terwijl je typt.
    inputEl.addEventListener('input', function () {
      var q = inputEl.value.trim().toLowerCase();
      if (!q) { render(defaultOrder()); return; }
      var hits = dealers.filter(function (d) {
        return (d.name + ' ' + (d.city || '') + ' ' + (d.postal || '')).toLowerCase().indexOf(q) !== -1;
      }).map(function (d) { return { d: d }; });
      render(hits);
    });

    // Zoeken (submit): postcode/plaats geocoderen → sorteren op afstand.
    formEl.addEventListener('submit', function (e) {
      e.preventDefault();
      var q = inputEl.value.trim();
      if (!q) { return; }
      statusEl.textContent = 'Zoeken…';
      var url = 'https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=nl,be&q=' + encodeURIComponent(q);
      fetch(url, { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (res) {
          if (res && res.length) {
            sortByDistance(parseFloat(res[0].lat), parseFloat(res[0].lon));
          } else {
            statusEl.textContent = 'Geen resultaat voor "' + q + '". Probeer een postcode of plaatsnaam.';
          }
        })
        .catch(function () { statusEl.textContent = 'Zoeken mislukt, probeer het later opnieuw.'; });
    });

    // Geolocatie-knop.
    geoBtn.addEventListener('click', function () {
      if (!navigator.geolocation) { statusEl.textContent = 'Locatie wordt niet ondersteund door je browser.'; return; }
      statusEl.textContent = 'Je locatie ophalen…';
      navigator.geolocation.getCurrentPosition(
        function (pos) { sortByDistance(pos.coords.latitude, pos.coords.longitude); },
        function () { statusEl.textContent = 'Kon je locatie niet bepalen. Geef toestemming of zoek op postcode.'; }
      );
    });

    // Lucide-iconen in dit blok activeren (mocht de globale init al gelopen zijn).
    if (window.lucide && window.lucide.createIcons) { window.lucide.createIcons(); }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
