                <fieldset class="panel panel-primary">
                    <div class="panel-body">
                        <div class="row">
                            <div class="cart-summary-wrapper">
                                <div class="col-xs-12 cart-summary">
                                        <h2>{{"Mijn bestelling"|t}}</h2>
                                        <div class="row checkout-row">
                                            <div class="col-md-12">
                                                <div class="cart-summary-list">
                                                    {% for item in cart.items %}
                                                        <div class="row">
                                                            <div class="col-xs-12 cart-summary-list-item">
                                                                <div class="row">
                                                                    <div class="col-xs-12">
                                                                        {{item.name}}
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-xs-6">
                                                                        <i>{{item.quantity}} x {{item.price|price}}</i>
                                                                    </div>
                                                                    <div class="col-xs-6 text-right pull-right">
                                                                        <strong>{{item.subtotal|price}}</strong>
                                                                    </div>
                                                                </div>
                                                                <hr>
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </div>
                                    <div class="checkout-table">
                                        <div class="cart-summary-order-info">
                                            <div class="row" id="checkout-table-credits">
                                                <div class="col-sm-6 text-right">
                                                    <strong>{{'Ingeleverde credits'|t}} </strong>
                                                </div>
                                                <div class="col-sm-6 text-right">
                                                    <span class="credit-total-amount"></span>
                                                </div>
                                            </div>
                                            <hr>
                                            <div class="row shipping-method-sum" id="checkout-table-shipping-cost">
                                                <div class="col-sm-6 text-right ">
                                                    <strong class="shipping-method-name"></strong>
                                                </div>
                                                <div class="col-sm-6 text-right">
                                                    <span class="shipping-cost-total"></span>
                                                </div>
                                            </div>
                                            <hr>
                                            <div class="row payment-method-sum" id="checkout-table-payment-cost">
                                                <div class="col-sm-6 text-right ">
                                                    <strong class="payment-method-name"></strong>
                                                    <small class="payment-method-issuer"></small>
                                                </div>
                                                <div class="col-sm-6 text-right">
                                                    <span class="payment-cost-total"></span>
                                                </div>
                                            </div>
                                            <hr>
                                            {% for vat in cart.vat %}
                                                <div class="row rowcheckout-tax-row checkout-tax-row-{{vat.rate}} original-tax-row" data-tax-amount="{{vat.amount}}">
                                                    <div class="col-sm-6 text-right ">
                                                        <strong class="payment-method-name">{{"BTW"|t}} ({{vat.rate}}%)</strong>
                                                    </div>
                                                    <div class="col-sm-6 text-right">
                                                        <span class=" vat-amount">{{vat.amount|price}}</span>
                                                    </div>
                                                </div>
                                            <hr>
                                            {% endfor %}
                                            {% if cart.coupon.is_active %}
                                                <div class="row" id="checkout-table-payment-cost">
                                                    <div class="col-sm-6 text-right ">
                                                        <strong>{{"coupon"|t}}: {{cart.coupon.code}} ({{cart.coupon.discount_rate}}%)</strong>
                                                    </div>
                                                    <div class="col-sm-6 text-right">
                                                        <span>{{cart.discount|price}}</span>
                                                    </div>
                                                </div>
                                            <hr>
                                            {% endif %}
                                            <div class="row checkout-table-total " data-total-amount="{{cart.total}}">
                                                <div class="col-sm-6 text-right ">
                                                    <strong>{{"Totaal"|t}}</strong>
                                                </div>
                                                <div class="col-sm-6 text-right total-amount">
                                                    <span class="total-amount">{{cart.total|price}}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% if captcha.enabled %}
                            <fieldset>
                                <h2>{{"Captcha"|t}}</h2>
                                <hr>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group captcha-field">
                                            <label for="sale[captcha]" class="col-sm-2 control-label verifyCaptchaLabelContainer">{{"Captcha"|t}}</label>
                                            <div class="col-sm-3">
                                                <div class="verifyCaptchaContainer">
                                                        {{captcha.img}}
                                                    <input type="text" name="sale[captcha]" class="center-block" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        {% endif %}
                        <hr>
                        <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#comments" aria-expanded="false" aria-controls="comments">
                            {{"Opmerking toevoegen"|t}}
                        </button>
                        <div class="row">
                             <div class="col-md-12">
                                <div class="collapse" id="comments">
                                    <div class="form-group comment-field">
                                        <textarea class="form-control" rows="5" name="sale[note][text]">{{post.sale.note.text}}</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>   
                    </div>
                    <div class="panel-footer">
                        <div class="row checkout-row">
                            <div class="col-md-12">
                                <a href="{{cart.url}}" class="btn btn-link">{{"Terug naar winkelmandje"|t}}</a>
                                <button type="submit" tabindex="19" class="btn btn-success btn-checkout pull-right">{{"Bestellen"|t}}</button>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>