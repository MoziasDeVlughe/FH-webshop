{# type: checkout #}

{% import "macros/displays.twig" as af_displays %}
<div class="container">
    {% for error in errors %}
        <div class="alert alert-danger" role="alert">{{error}}</div>
    {% endfor %}
    <h1>
        {{"Afrekenen"|t}}
    </h1>
    <hr>
    <div class="row">
        
        <div class="col-sm-6">
            <form id="checkout-form" class="form form-validate" method="POST" data-parsley-validate="" data-postal-code-url="https://app.afosto.com/address/_postcode">
                <fieldset>
                    <h2>{{"Mijn gegevens"|t}}</h2>
                    <hr>
                    <label>{{"Aanhef"|t}}</label>
                    <div class="form-group">
                        <input id="account_is_female" type="hidden" value="" name="customer[is_female]">
                        <div class="radio-inline">
                            <label for="account_is_female_0">
                            <input type="radio" name="customer[is_female]" id="account_is_female_0" value="0" {% if customer.is_female == false %} checked {% endif %} >
                                {{"Dhr."|t}}
                            </label> 
                        </div>
                        <div class="radio-inline">
                            <label for="account_is_female_1"> 
                            <input type="radio" name="customer[is_female]" id="account_is_female_1" value="1" {% if customer.is_female == true %} checked {% endif %} >
                                {{"Mvr."|t}}
                            </label> 
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="customer_name" class="control-label" value="{{post.customer.name}}">{{"Naam"|t}} <span class="required">*</span></label>
                        <input type="text" name="customer[name]" class="form-control required" id="customer_name"  value="{{post.customer.name}}" data-parsley-trigger="focusout">
                        <div class="field-error-container"></div>
                    </div>
                    <div class="input-append form-group date" id="dp3">
                        <label for="customer_birth_date" class="control-label">{{'Geboortedatum'|t}} <small>{{'(Niet verplicht)'|t}}</small></label>
                        <input class="form-control datepicker phoenix-input hidden" size="16" type="text" data-date-end-date="0d" id="customer_birth_date" name="date_holder" data-date="12-02-2012" data-parsley-pattern="^(0?[1-9]|[12][0-9]|3[01])\-(0?[1-9]|1[012])\-(\d{4})$"  data-date-format="dd-mm-yyyy" data-date-viewmode="years" tabindex="4" data-customer-birthdate="{{postdata.customer.birth_date}}" placeholder="dd-mm-jjjj">
                        <input class="form-control datefield phoenix-input hidden" type="date" name="date_holder" placeholder="dd-mm-jjjj" data-parsley-nofuturedates="{{"now"|date('Y-m-d')}}">
                        <input type="hidden" name="customer[birth_date]" value="" class="date_parser">
                    </div>
                    <div class="form-group">
                        <label for="customer_email" class="control-label">{{"E-mail"|t}} <span class="required">*</span></label>
                        <input type="email" name="customer[email]" class="form-control required" value="{{post.customer.email}}" id="customer_email" data-parsley-trigger="focusout">
                    </div>
                    <div class="form-group">
                        <label for="shipping_address_telephone" class="control-label">{{"Telefoonnummer"|t}}</label>
                        <input type="text" name="shipping[address][telephone]" class="form-control" id="shipping_address_telephone"  value="{{post.shipping.address.telephone}}">
                    </div>
                    <div class="form-group">
                        <label for="shipping_address_company" class="control-label">{{"Bedrijf"|t}}</label>
                        <input type="text" name="shipping[address][company]" class="form-control" id="shipping_address_company" value="{{post.shipping.address.company}}">
                    </div>
                </fieldset>
                <fieldset>
                    <h2>{{"Gegevens"|t}}</h2>
                    <hr>
                    <div class="form-group country-switch-shipping">
                        <label class="control-label">{{'Land'|t}}</label>
                        <div class="radio af">
                            <label class="radio-inline" for="address-shipping-is-nl1">
                              <input type="radio" name="shipping[isNL]" id="address-shipping-is-nl1" class="address-country-select phoenix-input" value="1" data-type="shipping" {% if postdata.shipping.isNL == 1 or postdata.shipping.isNL is not defined %}checked{% endif %}>
                              <div class="radio-button"></div>
                              {{'Nederland'|t}}
                            </label>
                        </div>
                        <div class="radio af">
                            <label class="radio-inline" for="address-shipping-is-nl2">
                              <input type="radio" name="shipping[isNL]" id="address-shipping-is-nl2" class="address-country-select phoenix-input" value="0" data-type="shipping" {% if postdata.shipping.isNL is defined and postdata.shipping.isNL == 0 %}checked{% endif %}>
                              <div class="radio-button"></div>
                              {{'Anders'|t}}
                            </label>
                        </div>
                        <div class="field-error-container"></div>
                    </div>
                    <div id="shipping-postal-code-container" class="shipping-container">
                        <div class="collapse country-collapsable">
                            <div class="form-group">
                                <select name="shipping[address][country][id]" class="form-control required phoenix-input" tabindex="6" id="shipping_address_country_id" value="{{postdata.shipping.address.country.id}}">
                                    {% for country in countries %}
                                        <option value="{{country.id}}" {% if postdata.shipping.address.country.id == country.id %}selected{% endif %} data-country-iso="{{country.iso}}">{{country.name}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-xs-12 col-sm-4 col-md-5">
                                <label for="shipping_address_postal_code1" class=" control-label">{{'Postcode'|t}} <span class="required">*</span></label>
                                <div class="validation-container">
                                    <input type="text" name="shipping[address][postal_code]" class="form-control required address-check-field phoenix-input" data-type="shipping" tabindex="7" id="shipping_address_postal_code1" data-parsley-group="group-step-1" value="{{postdata.shipping.address.postal_code}}">
                                </div>
                                <div class="field-error-container"></div>
                            </div>
                            <div class="form-group col-xs-7 col-sm-4">
                                <label for="shipping_address_house_number" class="col-sm- control-label">{{'Huisnummer'|t}} <span class="required">*</span></label>
                                <div class="validation-container">
                                    <input type="number" name="shipping[address][house_number]" class="form-control input-small required address-check-field phoenix-input" data-type="shipping" tabindex="8" id="shipping_address_house_number" data-parsley-group="group-step-1" value="{{postdata.shipping.address.house_number}}">
                                </div>
                                <div class="field-error-container"></div>
                            </div>
                            <div class="form-group col-xs-5 col-sm-4 col-md-3">
                                <label for="shipping_address_house_number_suffix" class="col-sm- control-label">{{'Toevoeging'|t}}</label>
                                <div class="validation-container">
                                    <input type="text" name="shipping[address][house_number_suffix]" class="form-control input-small phoenix-input" data-parsley-validate-if-empty data-type="shipping" tabindex="9" id="shipping_address_house_number_suffix" value="{{postdata.shipping.address.house_number_suffix}}">
                                </div>
                                <div class="field-error-container"></div>
                            </div>
                        </div>
                        <span class="address-validation-message" data-type="shipping" data-success-message="{{"Dit adres klopt."|t}}" data-error-message="{{"Dit adres klopt niet, controleer de velden."|t}}" data-loading-message="{{"Adres ophalen."|t}}"></span>
                        <div id="shipping_address_postal_code_result_container">
                            <div class="form-group">
                                <div class="postal-code-result" id="shipping_address">
                                    <div class="form-group">
                                        <label for="shipping_address_street" class="control-label">{{'Straat'|t}} <span class="required">*</span></label>
                                        <input type="text" name="shipping[address][street]" class="form-control required phoenix-input" tabindex="10" id="shipping_address_street" data-parsley-group="group-step-1" value="{{postdata.shipping.address.street}}">
                                    </div>
                                    <div class="form-group">
                                        <label for="shipping_address_city" class="control-label">{{'Woonplaats'|t}} <span class="required">*</span></label>
                                        <input type="text" name="shipping[address][city]" class="form-control required phoenix-input" tabindex="11" id="shipping_address_city"  data-parsley-group="group-step-1" value="{{postdata.shipping.address.city}}">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="same-address-check">
                        <div class="form-group">
                            <div class="checkbox af">
                                <label for="same-billing-address">
                                    <input type="checkbox" value="1" id="same-billing-address" class="phoenix-input" name="billing[is_shipping]" {% if (postdata.billing.is_shipping is not defined) or postdata.billing.is_shipping == 1 %}checked{% endif %}>
                                    <div class="checkbox-button"></div>
                                   {{'Factuuradres gelijk aan bezorgadres'|t}}
                                </label>
                            </div>
                        </div>
                    </div>
                    <div id="billing-complete-container" class="collapse" aria-expanded="false">
                        <div class="form-group country-switch-billing">
                            <label for="billing[isNL]" class="control-label">{{'Land'|t}} </label>
                            <div class="inline-radio-group">
                                <div class="radio af">
                                    <label class="radio-inline">
                                        <input type="radio" name="billing[isNL]" id="address-billing-is-nl1" class="address-country-select phoenix-input" data-type="billing" value="1" {% if postdata.billing.isNL == 1 or postdata.billing.isNL is not defined %}checked{% endif %}>
                                        <div class="radio-button"></div>
                                        {{'Nederland'|t}}
                                    </label>
                                </div>
                                <div class="radio af">
                                    <label class="radio-inline">
                                        <input type="radio" name="billing[isNL]" id="address-billing-is-nl2" class="address-country-select phoenix-input" data-type="billing" value="0" {% if postdata.billing.isNL == 0 and postdata.billing.isNL is defined %}checked{% endif %}>
                                        <div class="radio-button"></div>
                                        {{'Anders'|t}}
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="collapse country-collapsable">
                            <div class="form-group">
                                <select name="billing[address][country][id]" class="form-control required phoenix-input" id="billing_address_country_id" value="{{postdata.billing.address.country.id}}">
                                    {% for country in countries %}
                                        <option value="{{country.id}}" {% if postdata.billing.address.country.id == country.id %}selected{% endif %} data-country-iso="{{country.iso}}">{{country.name}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        {#<div class="form-group">#}
                        {#    <label for="billing_address_company" class="control-label">Bedrijf</label>#}
                        {#    <input type="text" name="billing[address][company]" class="form-control" tabindex="12" id="billing_address_company" value="{{postdata.billing.address.company}}" >#}
                        {#</div>#}
                        <div id="billing-postal-code-container" class="billing-container">
                            <div class="row">
                                <div class="form-group col-xs-12 col-sm-4 col-md-5">
                                    <label for="billing_address_postal_code1" class="control-label">{{'Postcode'|t}} <span class="required">*</span></label>
                                    <input type="text" name="billing[address][postal_code]" class="form-control required address-check-field phoenix-input" data-type="billing" tabindex="13" id="billing_address_postal_code1"data-parsley-group="group-step-1" value="{{postdata.billing.address.postal_code}}">
                                </div>
                                <div class="form-group col-xs-7 col-sm-4">
                                    <label for="billing_address_house_number" class="control-label">{{'Huisnummer'|t}} <span class="required">*</span></label>
                                    <input type="text" name="billing[address][house_number]" class="form-control required input-small address-check-field phoenix-input" data-type="billing" tabindex="14" id="billing_address_house_number" data-parsley-group="group-step-1" value="{{postdata.billing.address.house_number}}">
                                </div>
                                <div class="form-group col-xs-5 col-sm-4 col-md-3">
                                <label for="billing_address_house_number_suffix" class="col-sm- control-label">{{'Toevoeging'|t}}</label>
                                <input type="text" name="billing[address][house_number_suffix]" class="form-control input-small address-check-field phoenix-input" data-type="billing" tabindex="15" id="billing_address_house_number_suffix" value="{{postdata.billing.address.house_number_suffix}}">
                            </div>
                            </div>
                            <span class="address-validation-message" data-type="billing" data-success-message="{{"Dit adres klopt."|t}}" data-error-message="{{"Dit adres klopt niet, controleer de velden."|t}}" data-loading-message="{{"Adres ophalen."|t}}"></span>
                            <div id="billing_address_postal_code_result_container">
                                <div class="form-group">
                                    <div class="postal-code-result" id="billing_address_postal_code_result">
                                        <div class="form-group">
                                        <label for="billing_address_street" class="control-label">{{'Straat'|t}} <span class="required">*</span></label>
                                        <input type="text" name="billing[address][street]" class="form-control required phoenix-input" tabindex="16" id="billing_address_street" data-parsley-group="group-step-1" value="{{postdata.billing.address.street}}">
                                    </div>
                                    <div class="form-group">
                                        <label for="billing_address_city" class="control-label">{{'Woonplaats'|t}} <span class="required">*</span></label>
                                        <input type="text" name="billing[address][city]" class="form-control required phoenix-input" tabindex="17" id="billing_address_city" data-parsley-group="group-step-1" value="{{postdata.billing.address.city}}">
                                    </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>{{"Verzending"|t}}</h2>
                    <hr>
                    <div class="form-group">
                        <label for="sale_shipping_method_id" class="control-label">{{'Maak je keuze'|t}} <span class="required">*</span></label>
                        <div class="shipping-methods">
                            {% for method in shipping_methods|sort %}
                                    <div class="radio af shipping-method hidden" data-country="{{method.iso}}">
                                        <label>
                                            <input type="radio" {% if loop.first %} required="" data-parsley-required-message="{{'Kies een van de verzendmethodes om verder te gaan.'|t}}" {% endif %} data-parsley-group="group-step-2" name="sale[shipping][method][id]" class="shipping-method-option" id="sale_shipping_method_id_{{method.id}}" data-type="shipping" data-iso="{{method.iso}}" data-name="{{method.name}}" data-cost="{{method.cost}}" data-tax-rate="{{method.tax_rate}}" value="{{method.id}}" {% if postdata.sale.shipping.method.id == method.id or (postdata.sale.shipping.method.id is not defined and loop.parent.loop.first) %}checked{% endif %}>
                                            <div class="radio-button"></div>
                                            <strong>
                                                {{method.name}}
                                                {% if method.cost > 0 %}
                                                    <span class="method-cost"> ({{method.cost|price}})</span>
                                                {% endif %}
                                            </strong>
                                        </label>
                                        <div class="shipping-method-sub-options"></div>
                                    </div>
                            {% endfor %}
                        </div>
                    </div>
                    <input type="hidden" name="plugin[dhl_time_from]" class="shipping-option-field shipping-option-time-from" value="" />
                    <input type="hidden" name="plugin[dhl_pickup_spid]" class="shipping-option-field" value="" />
                    <input type="hidden" name="plugin[dhl_pickup_name]" class="shipping-option-field" value="" />
                    <input type="hidden" name="plugin[dhl_pickup_address]" class="shipping-option-field" value="" />
                    <input type="hidden" name="plugin[dhl_pickup_postal_code]" class="shipping-option-field" value="" />
                    <input type="hidden" name="plugin[dhl_pickup_city]" class="shipping-option-field" value="" />
                    
                    <input type="hidden" name="plugin[postnl_time_from]" class="shipping-option-field shipping-option-time-from" value="" />
                    <input type="hidden" name="plugin[postnl_pickup_spid]" class="shipping-option-field" value="" />
                    <input type="hidden" name="plugin[postnl_pickup_name]" class="shipping-option-field" value="" />
                    <input type="hidden" name="plugin[postnl_pickup_address]" class="shipping-option-field" value="" />
                    <input type="hidden" name="plugin[postnl_pickup_postal_code]" class="shipping-option-field" value="" />
                    <input type="hidden" name="plugin[postnl_pickup_city]" class="shipping-option-field" value="" />
                </fieldset>
                <fieldset>
                    <h2>{{"Betaling"|t}}</h2>
                    <hr>
                    <div class="form-group">
                        <label class=" control-label">{{"Selecteer een optie"|t}} <span class="required">*</span></label>
                        <div class="payment-methods">
                            {% for method in payment_methods|reverse %}
                                <div class="payment-method-row">
                                    <div class="radio af">
                                        <label {% if method.issuers is not empty %}data-issuers="{{method.code}}-list"{% endif %}>
                                            <div class="radio-label">
                                                <input type="radio" name="sale[payment][method][id]" {% if loop.first %} required="" data-parsley-required-message="{{'Kies een van de betaalmethodes om verder te gaan.'|t}}" {% endif %} data-parsley-multiple="payment_methods" data-parsley-group="group-step-3" id="sale_payment_method_id" class="payment-method-option" data-type="payment" data-name="{{method.name}}" data-code="{{method.code}}" data-cost="{{method.cost}}" data-tax-rate="{{method.tax_rate}}" value="{{method.id}}">
                                                <div class="radio-button"></div>
                                                {{method.name}}
                                                {% if method.cost > 0 %}
                                                    <span class="method-cost"> ({{method.cost|price}})</span>
                                                {% endif %}
                                            </div>
                                            {% if method.code != 'bill' and method.code != 'instore' and method.code != 'prepaid' %}
                                                {{af_displays.icon({
                                                    'id'    : method.description|lower,
                                                    'type'  : 'plain',
                                                    'class' : 'payment-menthod-icon partner-logo fill-primary'
                                                })}}
                                            {% endif %}
                                        </label>
                                    </div>
                                    <div class="row-divider"></div>
                                </div>
                                {% if method.issuers is not empty %}
                                    <div class="issuer-list collapse in {{method.code}}-list">
                                        <div class="well">
                                            <ul class="list-unstyled">
                                                {% for issuer in method.issuers %}
                                                    <li>
                                                        <div class="radio af">
                                                            <label>
                                                                <input type="radio" value="{{issuer.id}}" name="sale[payment][issuer][id]" id="sale_payment_issuer_id" data-name="{{issuer.name}}">
                                                                <div class="radio-button"></div>
                                                                {{issuer.name}}
                                                            </label>
                                                        </div>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </fieldset>
                 <fieldset>
                    <h2>{{"Opmerkingen"|t}}</h2>
                    <hr>
                    <div class="form-group comment-field">
                        <label for="sale[note][text]" class="control-label">{{"Opmerkingen / vragen"|t}}</label>
                        <textarea class="form-control" rows="5" name="sale[note][text]">{{post.sale.note.text}}</textarea>
                    </div>
                </fieldset>
                {% if captcha.enabled %}
                    <fieldset>
                        <h2>{{"Captcha"|t}}</h2>
                        <hr>
                        <div class="form-group captcha-field row">
                            <label for="sale[captcha]" class="col-sm-2 control-label verifyCaptchaLabelContainer">{{"Captcha"|t}}</label>
                            <div class="col-sm-3">
                                <div class="verifyCaptchaContainer">
                                    {{captcha.img}}
                                    <input type="text" name="sale[captcha]" class="center-block" />
                                </div>
                            </div>
                        </div>
                    </fieldset>
                {% endif %}
                <div class="checkout-row">
                    <div class="form-group">
                        <a href="{{cart.url}}" class="btn btn-link">{{"Terug naar winkelmandje"|t}}</a>
                        <button type="submit" class="btn btn-success btn-checkout pull-right">{{"Bestellen"|t}}</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-sm-6 cart-summary-wrapper">
            <div class="panel panel-primary cart-summary cart-summary-fixed">
                <div class="panel-heading">
                    <h4>{{"Mijn bestelling"|t}}</h4>
                </div>
                <div class="panel-body">
                    <div class="checkout-row">
                        <div class="cart-summary-list">
                            {% for item in cart.items %}
                                <div class="row">
                                    <div class="col-xs-12 cart-summary-list-item">
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <a href="{{item.url}}">{{item.name}}</a>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-xs-6">
                                                <i>{{item.quantity}} x {{item.price|price}}</i>
                                            </div>
                                            <div class="col-xs-6 text-right pull-right">
                                                <strong>{{item.subtotal|price}}</strong>
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <div class="panel-footer checkout-table">
                    <div class="cart-summary-order-info">
                        <div class="row" id="checkout-table-shipping-cost">
                            <div class="col-sm-6 text-right ">
                                <strong class="shipping-method-name"></strong>
                            </div>
                            <div class="col-sm-6 text-right">
                                <span class="shipping-cost-total"></span>
                            </div>
                        </div>
                        <hr>
                        <div class="row" id="checkout-table-payment-cost">
                            <div class="col-sm-6 text-right ">
                                <strong class="payment-method-name"></strong>
                            </div>
                            <div class="col-sm-6 text-right">
                                <span class="payment-cost-total"></span>
                            </div>
                        </div>
                        <hr>
                        {% for vat in cart.vat %}
                            <div class="row rowcheckout-tax-row checkout-tax-row-{{vat.rate}} original-tax-row" data-tax-amount="{{vat.amount}}">
                                <div class="col-sm-6 text-right ">
                                    <strong class="payment-method-name">{{"BTW"|t}} ({{vat.rate}}%)</strong>
                                </div>
                                <div class="col-sm-6 text-right">
                                    <span class=" vat-amount">{{vat.amount|price}}</span>
                                </div>
                            </div>
                        <hr>
                        {% endfor %}
                        {% if cart.coupon.is_active %}
                            <div class="row" id="checkout-table-payment-cost">
                                <div class="col-sm-6 text-right ">
                                    <strong>{{"coupon"|t}}: {{cart.coupon.code}} ({{cart.coupon.discount_rate}}%)</strong>
                                </div>
                                <div class="col-sm-6 text-right">
                                    <span>{{cart.discount|price}}</span>
                                </div>
                            </div>
                        <hr>
                        {% endif %}
                        <div class="row checkout-table-total " data-total-amount="{{cart.total}}">
                            <div class="col-sm-6 text-right ">
                                <strong>{{"Totaal"|t}}</strong>
                            </div>
                            <div class="col-sm-6 text-right total-amount">
                                <span class="total-amount">{{cart.total|price}}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>