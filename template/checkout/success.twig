        {% if not account.is_logged_in %}
            <div class="flex-100 flex-md-33 px-15 d-flex">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <h2 class="mt-0">
                            {{'Account aanmaken'|t}}
                        </h2>
                        <p>
                            {{'Maak een account aan om je orders terug te kijken en de volgende keer sneller te kunnen afrekenen.'|t}}
                        </p>
                    
                        <form action="{{account.signup_url}}" method="post" class="form form-validate" id="success-signup-form">
                            <div class="form-group">
                                <label>{{'Aanhef'|t}}</label>
                                <div class="radio af">
                                    <label for="account_is_female_0">
                                        <input class="phoenix-input" type="radio" name="customer[is_female]" id="account_is_female_0" value="0" {% if postdata.customer.is_female == false %} checked {% endif %} >
                                        <div class="radio-button"></div>
                                        {{'Man'|t}}  
                                    </label> 
                                </div>
                                
                                <div class="radio af">
                                    <label for="account_is_female_1"> 
                                        <input class="phoenix-input" type="radio" name="customer[is_female]" id="account_is_female_1" value="1" {% if postdata.customer.is_female == true %} checked {% endif %} >
                                        <div class="radio-button"></div>
                                        {{'Vrouw'|t}}
                                    </label> 
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label class="control-label" for="account_name">{{"Naam"|t}}</label>
                                <div class="validation-container">
                                    <input type="text" class="form-control" value="{{customer.first_name|e ~ ' ' ~ customer.last_name|e}}" id="account_name" name="account[name]" placeholder="{{"Je naam"|t}}" data-parsley-required="true" data-parsley-minlength="1">
                                </div>
                                <div class="field-error-container"></div>
                            </div>
                            <div class="form-group">
                                <label class="control-label" for="account_email">{{"E-mailadres"|t}}</label>
                                <div class="validation-container">
                                    <input type="text" class="form-control" id="account_email" name="account[email]" value="{{customer.email|e}}" placeholder="{{"Je e-mailadres"|t}}" data-parsley-type="email" data-parsley-required="true" >
                                </div>
                                <div class="field-error-container"></div>
                            </div>
                            <div class="form-group">
                                <label class="control-label" for="account_password">{{"Wachtwoord"|t}}</label>
                                <div class="validation-container">
                                    <input type="password" class="form-control" id="account_password" name="account[password]" placeholder="{{"Je wachtwoord"|t}}" data-parsley-required="true" data-parsley-minlength="4">
                                </div>
                                <div class="field-error-container"></div>
                            </div>
                            <div class="form-group mb-0">
                                <button type="submit" class="btn btn-primary">{{"Registreren"|t}}</button>
                            </div>
                        </form>
