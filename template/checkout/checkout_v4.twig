    										class="form-control address-check-field"
    										type="text"
    										name="premise_number_suffix"
    										id="new-shipping-premise-number-suffix"
    										data-type="new-shipping"
    									/>
    								</div>
    							</div>
    						</div>
    						<div class="form-group">
    							<label for="new-shipping-thoroughfare">
    								{{'Straat'|t}}<span class="text-danger">*</span>
    							</label>
    							<input 
    								class="form-control address-check-field"
    								type="text"
    								name="thoroughfare"
    								id="new-shipping-thoroughfare"
    								data-type="new-shipping"
    								required
    							/>
    						</div>
    						<div class="form-group">
    							<label for="new-shipping-locality">
    								{{'Plaats'|t}}<span class="text-danger">*</span>
    							</label>
    							<input 
    								class="form-control address-check-field"
    								type="text"
    								name="locality"
    								id="new-shipping-locality"
    								data-type="new-shipping"
    								required
    							/>
    						</div>
    						<div class="form-group">
    							<label for="new-shipping-administrative-area">
    								{{'Regio'|t}}<span class="text-danger">*</span>
    							</label>
    							<input 
    								class="form-control"
    								type="text"
    								name="administrative-area"
    								id="new-shipping-administrative-area"
    							/>
    						</div>
    						<div class="address-validation-message" data-type="new-shipping" data-success-message="adres gevalideerd" data-error-message="Dit adres is niet bij ons bekend, controleer de velden." data-loading-message="Adres controleren..."></div>
    						<div class="form-group d-flex align-items-center mb-0">
    							<div class="checkbox af">
    								<label>
    									<input type="checkbox" name="save_address" class="form-control" id="new-shipping-save-address" data-type="new-shipping">
    									<div class="checkbox-button"></div>
    									{{'Adres opslaan als'|t}}
    								</label>
    							</div>
    							<div class="form-group mb-0 ml-10">
        							<select 
    									class="form-control input-sm py-0 pr-40"
    									name="save_address_as"
    									id="new-shipping-save-address-as"
    									data-type="new-billing"
    									required
    								>
    									<option value="contact">{{'Contact adres'|t}}</option>
    									<option value="organisation" disabled>{{'Organisatie adres'|t}}</option>
    								</select>
    							</div>
    						</div>
    						<div class="form-group d-flex">
    							<div class="checkbox af">
    								<label>
    									<input type="checkbox" name="save_address_as_primary" class="form-control" id="new-shipping-save-address-as-primary" data-type="new-shipping">
    									<div class="checkbox-button"></div>
    									{{'Opslaan als primair adres'|t}}
    								</label>
    							</div>
    						</div>
    					</div>
    					<div class="modal-footer">
    						<button type="button" class="btn btn-primary-inverse" data-action="toggle-new-address-form" data-toggle-to="hidden">
    							{{'Annuleren'|t}}
    						</button>
    						<button type="submit" class="btn btn-primary">
    							{{'Toevoegen'|t}}
    						</button>
    					</div>
    				</form>
    			</div>
    		</div>
    	</div>
    	<div class="modal fade" id="organisation-select" tabindex="-1" role="dialog" aria-labelledby="organisation-select-label">
    		<div class="modal-dialog" role="document">
    			<div class="modal-content">
    				<div class="organisation-options-container">
    					<div class="modal-header">
    						<div class="h4 text-center my-0 fw-bold" id="organisation-select-label">{{'Uw bedrijven'|t}}</div>
    						<button type="button" class="close" data-dismiss="modal" aria-label="Close"></button>
    					</div>
    					<div class="modal-body">
    						<div class="organisation-options"></div>
    					</div>
    					<div class="modal-footer">
    						<button type="button" class="btn btn-primary" data-action="toggle-new-organisation-form" data-toggle-to="visible">
    							{{'Nieuw bedrijf'|t}}
    						</button>
    					</div>
    				</div>	
    				<form class="new-organisation-container create-organisation-form hidden form-validate" id="new-organisation-form">
    					<div class="modal-header">
    						<div class="h4 text-center my-0 fw-bold" id="shipping-addresses-label">{{'Nieuw bedrijf'|t}}</div>
    						<button type="button" class="close" data-dismiss="modal" aria-label="Close"></button>
    					</div>
    					<div class="modal-body">
    						<div class="form-group">
    							<label for="new-organisation-name">
    								{{'Bedrijfsnaam'|t}}<span class="text-danger">*</span>
    							</label>
    							<input 
    								class="form-control"
    								type="text"
    								name="name"
    								id="new-organisation-name"
    								required
    							/>
    						</div>
    						<div class="form-group">
    							<label for="new-organisation-country-code">
    								{{'Land'|t}}
    							</label>
    							<select 
    								class="form-control"
    								name="country_code"
    								id="new-organisation-country-code"
    							>
    								<option value="NL">{{'Nederland'|t}}</option>
    								<option value="BE">{{'België'|t}}</option>
    								<option value="LU">{{'Luxemburg'|t}}</option>
    							</select>
    						</div>
    						<div class="form-group">
    							<label for="new-organisation-vat-number">
    								{{'BTW nummer'|t}}<span class="text-danger">*</span>
    							</label>
    							<input 
    								class="form-control"
    								type="text"
    								name="number"
    								id="new-organisation-vat-number"
    								required
    								data-invalid-number-message="{{'Vul een geldig btw nummer in'|t}}"
    							/>
    						</div>
    						<div class="form-group coc-number-container">
    							<label for="new-organisation-coc-number">
    								{{'KvK nummer'|t}}
    							</label>
    							<input 
    								class="form-control"
    								type="text"
    								name="coc_number"
    								id="new-organisation-coc-number"
    							/>
    						</div>
    					</div>
    					<div class="modal-footer">
    						<button type="button" class="btn btn-primary-inverse" data-action="toggle-new-organisation-form" data-toggle-to="hidden">
    							{{'Annuleren'|t}}
    						</button>
    						<button type="submit" class="btn btn-primary">
    							{{'Toevoegen'|t}}
    						</button>
    					</div>
    				</form>
    			</div>
    		</div>
    	</div>
    	<div class="modal fade" id="change-phonenumber" tabindex="-1" role="dialog" aria-labelledby="change-phonenumber-label">
    		<div class="modal-dialog" role="document">
    			<div class="modal-content">
    			    <div class="phonenumber-options-container">
    			        <div class="modal-header">
    						<div class="h4 text-center my-0 fw-bold" id="change-phonenumber-label">{{'Nieuw telefoonnummer'|t}}</div>
    						<button type="button" class="close" data-dismiss="modal" aria-label="Close"></button>
    					</div>
    					<div class="modal-body">
    			            <div class="phonenumber-options"></div>
    			        </div>
    			        <div class="modal-footer">
    						<button type="button" class="btn btn-primary" data-action="toggle-new-phonenumber-form" data-toggle-to="visible">
    							{{'Nieuw telefoonnummer'|t}}
    						</button>
    					</div>
    			    </div>
    				<form class="new-phonenumber-container hidden create-phonenumber-form form-validate" id="new-phonenumber-form">
    					<div class="modal-header">
    						<div class="h4 text-center my-0 fw-bold" id="change-phonenumber-label">{{'Nieuw telefoonnummer'|t}}</div>
    						<button type="button" class="close" data-dismiss="modal" aria-label="Close"></button>
    					</div>
    					<div class="modal-body">
    						<div class="row" id="contact-phonenumber-form">
    							<div class="col-xs-5 col-sm-4 col-md-3">
    								<div class="form-group">
    									<label for="contact-new-phonenumber-country">{{'Landnummer'|t}}</label>
    									<select class="form-control" name="country_code" id="contact-new-phonenumber-country" data-parsley-group="step-1">
    										<option {% if language == 'nl' %}selected {% endif %}value="NL">{{'+31 (NL)'|t}}</option>
    										<option {% if language == 'be' %}selected {% endif %}value="BE">{{'+32 (BE)'|t}}</option>
    										<option value="LU">{{'+352 (LU)'|t}}</option>
    									</select>
    								</div>
    							</div>
    							<div class="col-xs-7 col-sm-8 col-md-9">
    								<div class="form-group">
    									<label for="contact-new-phonenumber">{{'Telefoonnummer'|t}}<span class="text-danger">*</span></label>
    									<input
    									    class="form-control"
    									    type="tel"
    									    name="number"
    									    id="contact-new-phonenumber"
    									    required
    									    data-invalid-number-message="{{'Vul een geldig telefoonnummer in'|t}}"
    									    data-parsley-validtel='{ "countryCodeInput": "#contact-new-phonenumber-country", "numberInput": "#contact-new-phonenumber" }'
    									>
    								</div>
    							</div>
    						</div>
    					</div>
    					<div class="modal-footer">
    						<button type="button" class="btn btn-primary-inverse" data-action="toggle-new-phonenumber-form" data-toggle-to="hidden">
    							{{'Annuleren'|t}}
    						</button>
    						<button type="submit" class="btn btn-primary">
    							{{'Toevoegen'|t}}
    						</button>
    					</div>
    				</form>
    			</div>
    		</div>
    	</div>
    	<div class="modal fade" id="edit-contact" tabindex="-1" role="dialog" aria-labelledby="edit-contact-label">
    		<div class="modal-dialog" role="document">
		        <form id="edit-account-form" class="form-validate">
        			<div class="modal-content">
        				<div class="modal-header">
        					<div class="h4 text-center my-0 fw-bold" id="edit-contact-label">{{'Gegevens bewerken'|t}}</div>
        					<button type="button" class="close" data-dismiss="modal" aria-label="Close"></button>
        				</div>
        				<div class="modal-body">
    						<div class="form-group"> 
    							<label for="edit-account-email">
    								{{'E-mailadres'|t}}
    							</label>
    							<input 
    								class="form-control"
    								type="email"
    								name="account_email"
    								autocomplete="username"
    								id="edit-account-email"
    								required
    							/>
    						</div>
    						<div class="contact-extra-fields-container" data-linked-form="#edit-account-form">
        						<div class="form-group"> 
        							<label for="edit-account-given-name">
        								{{'Voornaam'|t}}
        							</label>
        							<input 
        								class="form-control"
        								type="text"
        								name="account_given_name"
        								autocomplete="given_name"
        								id="edit-account-given-name"
        								required
        								data-copy-to="#billing-given-name"
        							/>
        						</div>
        						<div class="form-group"> 
        							<label for="edit-account-additional-name">
        								{{'Tussenvoegsel'|t}}
        							</label>
        							<input 
        								class="form-control"
        								type="text"
        								name="account_additional_name"
        								autocomplete="additional_name"
        								id="edit-account-additional-name"
        								data-copy-to="#billing-additional-name"
        							/>
        						</div>
        						<div class="form-group"> 
        							<label for="edit-account-family-name">
        								{{'Achternaam'|t}}
        							</label>
        							<input 
        								class="form-control"
        								type="text"
        								name="account_family_name"
        								autocomplete="family_name"
        								id="edit-account-family-name"
        								required
        								data-copy-to="#billing-family-name"
        							/>
        						</div>
    						</div>
        				</div>
        				<div class="modal-footer">
        					<button class="btn btn-primary-inverse" type="button" data-dismiss="modal">
        						{{'Annuleren'|t}}
        					</button>
        					<button class="btn btn-primary" type="submit">
        						{{'Opslaan'|t}}
        					</button>
        				</div>
        			</div>
				</form>
    		</div>
    	</div>
    	<div class="modal fade" id="insufficient-balance-error" tabindex="-1" role="dialog" aria-labelledby="insufficient-balance-error-label">
    		<div class="modal-dialog" role="document">
    			<div class="modal-content">
    				<div class="modal-header">
    					<div class="h4 text-center my-0 fw-bold" id="insufficient-balance-error-label">{{'Onvoldoende balans'|t}}</div>
    					<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    				</div>
    				<div class="modal-body">
    				    <p>
    				        {{'U heeft onvoldoende balans open staan op om rekening te betalen. Kies een andere methode of neem contact op met de verkoper.'|t}}
    				    </p>
    				</div>
    				<div class="modal-footer">
    					<button type="button" class="btn btn-primary" data-action="go-to-checkout-step" data-step="3" data-disable-validation data-dismiss="modal">
    						{{'Andere betaalmethode kiezen'|t}}
    					</button>
    				</div>
    			</div>
    		</div>
    	</div>
    	
    	<div class="validating-organisation">
    	    <div class="validating-organisation-message">
    	        {{'Organisatie valideren...'|t}}
    	    </div>
    	</div>
    </div>
    
{% endblock configProvider %}