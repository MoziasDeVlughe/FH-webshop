{% extends 'config.twig' %}



{% block configProvider %}
    <div id="checkout-v4" class="stepped container py-50" data-active-step="1" style="max-width: 800px" data-session-id="{{session_id}}">
    {#<div id="checkout-v4" class="stepped container py-50" data-active-step="1" style="max-width: 800px" data-session-id="abcdefg">#}
    	<div id="checkout-progress" class="step-1">
    		<div class="checkout-progress-bar">
    			<div class="step step-1 active">
    				<span>1</span>
    				<div class="fa fa-check" aria-hidden="true"></div>
    				<div class="step-label">{{'Gegevens'|t}}</div>
    			</div>
    			<div class="step step-2">
    				<span>2</span>
    				<div class="fa fa-check" aria-hidden="true"></div>
    				<div class="step-label">{{'Verzenden'|t}}</div>
    			</div>
    			<div class="step step-3">
    				<span>3</span>
    				<div class="fa fa-check" aria-hidden="true"></div>
    				<div class="step-label">{{'Betalen'|t}}</div>
    			</div>
    			<div class="step step-4">
    				<span>4</span>
    				<div class="fa fa-check" aria-hidden="true"></div>
    				<div class="step-label">{{'Afrekenen'|t}}</div>
    			</div>
    		</div>
    	</div>
    	
    	<div id="step-1" class="checkout-step">
    		<div class="panel panel-default">
    			<div class="panel-body">
    				<div class="user-container">
    					<form id="account-form" class="form-validate">
    						<div class="form-group"> 
    							<label for="account-email">
    								{{'E-mailadres'|t}}
    							</label>
    							<input 
    								class="form-control account-create-field"
    								type="email"
    								name="account_email"
    								autocomplete="username"
    								id="account-email"
    								required
    								data-parsley-group="step-1"
    							/>
    						</div>
    						<div class="hidden" id="login-extra-fields">
    							<p>
    								{{'Welkom terug! Login om je opgeslagen gegevens te gebruiken.'|t}}
    							</p>
    						 	<div class="form-group">
    								<label for="account-password">
    									{{'Wachtwoord'|t}}
    								</label>
    								<input
    									class="form-control"
    									type="password"
    									name="account_password"
    									autocomplete="current-password"
    									id="account-password"
    									required
    								/>
    							</div>
    							<div class="form-group">
    								<button class="btn btn-primary" type="submit" data-action="login">
    									{{'login'|t}}
    								</button>
    							</div>
    							<hr>
    						</div>
    					</form>
    					<div class="contact-extra-fields contact-extra-fields-container" data-linked-form="#account-form">
    						<div class="form-group"> 
    							<label for="account-given-name">
    								{{'Voornaam'|t}}
    							</label>
    							<input 
    								class="form-control account-create-field"
    								type="text"
    								name="account_given_name"
    								autocomplete="given_name"
    								id="account-given-name"
    								required
    								data-parsley-group="step-1"
    								data-copy-to="#billing-given-name"
    							/>
    						</div>
    						<div class="form-group"> 
    							<label for="account-additional-name">
    								{{'Tussenvoegsel'|t}}
    							</label>
    							<input 
    								class="form-control account-create-field"
    								type="text"
    								name="account_additional_name"
    								autocomplete="additional_name"
    								id="account-additional-name"
    								data-parsley-group="step-1"
    								data-copy-to="#billing-additional-name"
    							/>
    						</div>
    						<div class="form-group"> 
    							<label for="account-family-name">
    								{{'Achternaam'|t}}
    							</label>
    							<input 
    								class="form-control account-create-field"
    								type="text"
    								name="account_family_name"
    								autocomplete="family_name"
    								id="account-family-name"
    								required
    								data-parsley-group="step-1"
    								data-copy-to="#billing-family-name"
    							/>
    						</div>
    					</div>
    					<div id="created-display" class="panel panel-default panel-body hidden">
    						<div class="d-flex justify-content-between align-items-center">
    							<div>
    								<span id="created-user-fullname"></span><br>
    								<span id="created-user-email"></span>
    							</div>
    							<button class="btn btn-primary-inverse" type="button" data-toggle="modal" data-target="#edit-contact">
    								{{'Bewerken'|t}}
    							</button>
    						</div>
    					</div>
    					<div id="user-display" class="panel panel-default panel-body hidden">
    						<div class="d-flex justify-content-between align-items-baseline">
    							<div>
    								{{'Ingelogd als:'|t}} <span id="user-email"></span>
    							</div>
    							{#<button class="btn btn-primary" type="button" data-action="logout">#}
    							{#	uitloggen#}
    							{#</button>#}
    						</div>
    					</div>
    				</div>
    				{% if isB2B %}
        				<hr>
        			    <h2 id="organisation-heading-static">
        			        {{'Bedrijf'|t}}
        			    </h2>
        				<div class="organisation-container">
        					<form class="organisation-form" id="organisation-fields">
        						<div class="form-group">
        							<label for="organisation-name">{{'Bedrijfsnaam'|t}}<span class="text-danger">*</span></label>
        							<input class="form-control" type="text" name="name" id="organisation-name" data-copy-to="#billing-organisation" data-parsley-group="step-1">
        						</div>
        						<div class="form-group">
        							<label for="organisation-vat-number">{{'BTW nummer'|t}}<span class="text-danger">*</span></label>
        							<input class="form-control" type="text" name="number" id="organisation-vat-number" data-parsley-group="step-1" data-invalid-number-message="{{'Vul een geldig btw nummer in'|t}}">
        						</div>
        						<div class="form-group">
        							<label for="organisation-coc-number">{{'KVK-nummer'|t}}</label>
        							<input
        							    class="form-control"
        							    type="text"
        							    name="coc_number"
        							    id="organisation-coc-number"
        							    data-parsley-group="step-1"
        							    data-parsley-required-if="#organisation-name"
        							    data-parsley-validate-if-empty="true"
        							>
        						</div>
        						<div class="form-group">
        							<label for="organisation-country-code">{{'Land'|t}}</label>
        							<select class="form-control" name="country_code" id="organisation-country-code" data-parsley-group="step-1">
        								<option value="NL">{{'Nederland'|t}}</option>
        								<option value="BE">{{'België'|t}}</option>
        								<option value="LU">{{'Luxemburg'|t}}</option>
        							</select>
        						</div>
        					    <div class="clearfix"></div>
        					</form>
        					
        					<div class="active-organisation hidden"></div>
        					<div class="organisation-contact hidden account-managers-input" data-parsley-group="step-1">
        					    <div class="form-group">
        					        <label for="organisation-contact">
        					            {{'Contact persoon'|t}}
        					        </label>
        					        <input class="form-control" type="email" name="organisation-contact" id="organisation-contact">
        					    </div>
        					</div>
        					<button class="btn btn-primary-inverse show-organisations hidden" type="button" data-toggle="modal" data-target="#organisation-select">
        						{{'Ander bedrijf'|t}}
        					</button>
        				</div>
        			{% endif %}
    				<hr>
    				{#<h2>{{'Telefoonnummer'|t}}</h2>#}
    				<div class="phonenumber-container">
    					<div class="row" id="contact-phonenumber-form">
    						<div class="col-xs-5 col-sm-4 col-md-3">
    							<div class="form-group">
    								<label for="contact-phonenumber">{{'Landnummer'|t}}</label>
    								<select class="form-control" name="contact-phonenumber-country" id="contact-phonenumber-country" data-parsley-group="step-1">
    									<option {% if language == 'nl' %}selected {% endif %}value="NL">{{'+31 (NL)'|t}}</option>
    									<option {% if language == 'be' %}selected {% endif %}value="BE">{{'+32 (BE)'|t}}</option>
    									<option value="LU">{{'+352 (LU)'|t}}</option>
    								</select>
    							</div>
    						</div>
    						<div class="col-xs-7 col-sm-8 col-md-9">
    							<div class="form-group">
    								<label for="contact-phonenumber">{{'Telefoonnummer'|t}}</label>
    								<input class="form-control" type="tel" name="contact-phonenumber" id="contact-phonenumber" data-parsley-group="step-1" data-parsley-validtel='{ "countryCodeInput": "#contact-phonenumber-country", "numberInput": "#contact-phonenumber" }'>
    							</div>
    						</div>
    					</div>
    					<div class="active-phonenumber hidden"></div>
    					<button class="btn btn-primary-inverse show-phonenumber-form hidden" data-toggle="modal" data-target="#change-phonenumber">
    						{{'Ander telefoonnummer'|t}}
    					</button>
    				</div>
    				{% if not isB2B %}
        				<hr>
        				<div id="organisation-heading-button">
        				    <div class="">
        				        <div class="checkbox af">
        				            <label for="toggle-organisation-fields">
        				                <input type="checkbox" id="toggle-organisation-fields" class="toggle-on-check" data-target="#organisation-info" data-clear-form-on-uncheck="#organisation-fields">
        				                <div class="checkbox-button"></div>
        				                {{'Zakelijke bestelling'|t}}
        				            </label>
        				        </div>
        				    </div>
        			    </div>
        			    <h2 class="hidden" id="organisation-heading-static">
        			        {{'Bedrijf'|t}}
        			    </h2>
        				<div class="organisation-container">
        					<form class="organisation-form" id="organisation-fields">
        			            <div class="collapse" id="organisation-info">
            						<div class="form-group pt-15">
            							<label for="organisation-name">{{'Bedrijfsnaam'|t}}<span class="text-danger">*</span></label>
            							<input class="form-control" type="text" name="name" id="organisation-name" data-copy-to="#billing-organisation" data-parsley-group="step-1">
            						</div>
            						<div class="form-group">
            							<label for="organisation-country-code">{{'Land'|t}}</label>
            							<select class="form-control" name="country_code" id="organisation-country-code" data-parsley-group="step-1">
            								<option {% if language == 'nl' %}selected {% endif %}value="NL">{{'Nederland'|t}}</option>
            								<option {% if language == 'be' %}selected {% endif %}value="BE">{{'België'|t}}</option>
            								<option value="LU">{{'Luxemburg'|t}}</option>
            							</select>
            						</div>
            						<div class="form-group">
            							<label for="organisation-vat-number">{{'BTW nummer'|t}}<span class="text-danger">*</span></label>
            							<input
            							    class="form-control"
            							    type="text"
            							    name="number"
            							    id="organisation-vat-number"
            							    data-parsley-group="step-1"
            							    data-invalid-number-message="{{'Vul een geldig btw nummer in'|t}}"
            							    data-parsley-required-if="#organisation-name"
            							    data-parsley-validate-if-empty="true"
            							>
            						</div>
            						<div class="form-group coc-number-container">
            							<label for="organisation-coc-number">{{'KVK-nummer'|t}}</label>
            							<input
            							    class="form-control"
            							    type="text"
            							    name="coc_number"
            							    id="organisation-coc-number"
            							    data-parsley-group="step-1"
            							>
            						</div>
            					    <div class="clearfix"></div>
        				        </div>
        					</form>
        					
        					<div class="active-organisation hidden"></div>
        					<div class="organisation-contact hidden account-managers-input" data-parsley-group="step-1">
        					    <div class="form-group">
        					        <label for="organisation-contact">
        					            {{'Contact persoon'|t}}
        					        </label>
        					        <input class="form-control" type="email" name="organisation-contact" id="organisation-contact">
        					    </div>
        					</div>
        					<button class="btn btn-primary-inverse show-organisations hidden" type="button" data-toggle="modal" data-target="#organisation-select">
        						{{'Ander bedrijf'|t}}
        					</button>
        				</div>
    				{% endif %}
    				<hr>
    				<h2>{{'Factuuradres'|t}}</h2>
    				<div class="address-container" data-address-type="billing">
    					<form class="address-form" id="billing-address-field">
    						<div class="form-group">
    							<label for="billing-given-name">
    								{{'Voornaam'|t}}
    							</label>
    							<input 
    								class="form-control"
    								type="text"
    								name="given_name"
    								id="billing-given-name"
    								autocomplete="given-name"
    								required
    								data-parsley-group="step-1"
    							/>
    						</div>
    						<div class="form-group">
    							<label for="billing-additional-name">
    								{{'Tussenvoegsel'|t}}
    							</label>
    							<input 
    								class="form-control"
    								type="text"
    								name="additional_name"
    								id="billing-additional-name"
    								autocomplete="additional-name"
    								data-parsley-group="step-1"
    							/>
    						</div>
    						<div class="form-group">
    							<label for="billing-family-name">
    								{{'Achternaam'|t}}
    							</label>
    							<input 
    								class="form-control"
    								type="text"
    								name="family_name"
    								id="billing-family-name"
    								autocomplete="family-name"
    								required
    								data-parsley-group="step-1"
    							/>
    						</div>
    						<div class="form-group">
    							<label for="billing-organisation">
    								{{'Bedrijfsnaam'|t}}
    							</label>
    							<input 
    								class="form-control"
    								type="text"
    								name="organisation"
    								id="billing-organisation"
    								autocomplete="organization"
    								data-parsley-group="step-1"
    							/>
    						</div>
    						<div class="form-group">
    							<label for="billing-country-code">
    								{{'Land'|t}}
    							</label>
    							<select 
    								class="form-control address-check-field"
    								name="country_code"
    								id="billing-country-code"
    						  		data-type="billing"
    								autocomplete="country-code"
    								required
    								data-parsley-group="step-1"
    							>
    								<option value="NL">{{'Nederland'|t}}</option>
    								<option value="BE">{{'België'|t}}</option>
    								<option value="LU">{{'Luxemburg'|t}}</option>
    							</select>
    						</div>
    						<div class="row">
    							<div class="col-xs-12 col-sm-4 col-md-5">
    								<div class="form-group">
    									<label for="billing-postal-code">
    										{{'Postcode'|t}}
    									</label>
    									<input 
    										class="form-control address-check-field"
    										type="text"
    										name="postal_code"
    										id="billing-postal-code"
    										data-type="billing"
    										autocomplete="postal-code"
    										required
    										data-parsley-group="step-1"
    									/>
    								</div>
    							</div>
    							<div class="col-xs-7 col-sm-4">
    								<div class="form-group">
    									<label for="billing-premise-number">
    										{{'Huisnummer'|t}}
    									</label>
    									<input 
    										class="form-control address-check-field"
    										type="text"
    										name="premise_number"
    										id="billing-premise-number"
    										data-type="billing"
    										autocomplete="address-line3"
    										required
    										data-parsley-group="step-1"
    									/>
    								</div>
    							</div>
    							<div class="col-xs-5 col-sm-4 col-md-3">
    								<div class="form-group">
    									<label for="billing-premise-number-suffix">
    										{{'Toevoeging'|t}}
    									</label>
    									<input 
    										class="form-control address-check-field"
    										type="text"
    										name="premise_number_suffix"
    										id="billing-premise-number-suffix"
    										data-type="billing"
    										data-parsley-group="step-1"
    									/>
    								</div>
    							</div>
    						</div>
    						<div class="form-group">
    							<label for="billing-thoroughfare">
    								{{'Straat'|t}}
    							</label>
    							<input 
    								class="form-control address-check-field"
    								type="text"
    								name="thoroughfare"
    								id="billing-thoroughfare"
    								data-type="billing"
    								required
    								data-parsley-group="step-1"
    							/>
    						</div>
    						<div class="form-group">
    							<label for="billing-locality">
    								{{'Plaats'|t}}
    							</label>
    							<input 
    								class="form-control address-check-field"
    								type="text"
    								name="locality"
    								id="billing-locality"
    								data-type="billing"
    								required
    								data-parsley-group="step-1"
    							/>
    						</div>
    						{% if isB2B %}
        						<div class="form-group">
        							<label for="billing-administrative-area">
        								{{'Regio'|t}}
        							</label>
        							<input 
        								class="form-control"
        								type="text"
        								name="administrative-area"
        								id="billing-administrative-area"
        							/>
        						</div>
    						{% endif %}
    						<div class="address-validation-message" data-type="billing" data-success-message="adres gevalideerd" data-error-message="Dit adres is niet bij ons bekend, controleer de velden." data-loading-message="Adres controleren..."></div>
    					</form>
    					<div class="active-address hidden"></div>
    					<div
    						class="billing-address-error text-danger mb-10"
    						data-no-option-selected-message="Selecteer een adres of maak een aan om verder te gaan."
    					></div>
    					<button class="btn btn-primary-inverse show-addresses hidden" data-toggle="modal" data-target="#billing-addresses">
    						{{'Ander adres'|t}}
    					</button>
    				</div>
    			</div>
    			<div class="panel-footer d-flex justify-content-between flex-row-reverse">
    				<button class="btn btn-primary" type="button" data-action="go-to-checkout-step" data-step="2">{{'Volgende'|t}}</button>
    			</div>
    		</div>
    	</div>
    	<div id="step-2" class="checkout-step">
    		<div class="panel panel-default">
    			<div class="panel-body">
    				<div class="shipping-method-info" data-shipping-type="delivery">
    					<h2>{{'Verzendadres'|t}}</h2>
    					<div class="address-container" data-address-type="shipping">
    						<form class="address-form" id="shipping-address-field">
    							<div class="checkbox af">
    								<label>
    									<input type="checkbox" class="form-control" id="shipping-same-as-billing" data-action="collapse" data-target="#shipping-address-collapse">
    									<div class="checkbox-button"></div>
    									{{'Mijn verzendadres is anders dan mijn factuuradres'|t}}
    								</label>
    							</div>
    							<div class="collapse" id="shipping-address-collapse">
    								<div class="form-group">
    									<label for="shipping-given-name">
    										{{'Voornaam'|t}}
    									</label>
    									<input 
    										class="form-control"
    										type="text"
    										name="given_name"
    										id="shipping-given-name"
    										required
    										data-parsley-group="step-2"
    									/>
    								</div>
    								<div class="form-group">
    									<label for="shipping-additional-name">
    										{{'Tussenvoegsel'|t}}
    									</label>
    									<input 
    										class="form-control"
    										type="text"
    										name="additional_name"
    										id="shipping-additional-name"
    										data-parsley-group="step-2"
    									/>
    								</div>
    								<div class="form-group">
    									<label for="shipping-family-name">
    										{{'Achternaam'|t}}
    									</label>
    									<input 
    										class="form-control"
    										type="text"
    										name="family_name"
    										id="shipping-family-name"
    										required
    										data-parsley-group="step-2"
    									/>
    								</div>
    								<div class="form-group">
    									<label for="shipping-organisation">
    										{{'Bedrijfsnaam'|t}}
    									</label>
    									<input 
    										class="form-control"
    										type="text"
    										name="organisation"
    										id="shipping-organisation"
    										data-parsley-group="step-2"
    									/>
    								</div>
    								<div class="form-group">
    									<label for="shipping-country-code">
    										{{'Land'|t}}
    									</label>
    									<select 
    										class="form-control address-check-field"
    										name="country_code"
    										id="shipping-country-code"
    										data-type="shipping"
    										required
    										data-parsley-group="step-2"
    									>
    										<option value="NL">{{'Nederland'|t}}</option>
    										<option value="BE">{{'België'|t}}</option>
    										<option value="LU">{{'Luxemburg'|t}}</option>
    									</select>
    								</div>
    								<div class="row">
    									<div class="col-xs-12 col-sm-4 col-md-5">
    										<div class="form-group">
    											<label for="shipping-postal-code">
