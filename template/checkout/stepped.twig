<div class="container">
    <div id="checkout-progress" class="step-1">
        <div class="checkout-progress-bar">
            <div class="step step-1 active"><span> 1</span>
                <div class="fa fa-check"></div>
                <div class="step-label"> {{'gegevens'|t}}</div>
            </div>
            <div class="step step-2"><span> 2</span>
                <div class="fa fa-check"></div>
                <div class="step-label"> {{"verzenden"|t}}</div>
            </div>
            <div class="step step-3"><span> 3</span>
                <div class="fa fa-check"></div>
                <div class="step-label"> {{"betalen"|t}}</div>
            </div>
            <div class="step step-4"><span> 4</span>
                <div class="fa fa-check"></div>
                <div class="step-label"> {{"afrekenen"|t}}</div>
            </div>
        </div>
    </div>
</div>
    
<div class="container mb-20">
    <form 
        id="checkout-form" 
        class="form form-validate stepped" 
        method="POST" 
        {#data-parsley-validate=""#}
        data-providers="{{providers|join(',')}}" 
        data-hour="{{"now"|date("H")}}" 
        data-af-local="" 
        data-postal-code-url="https://app.afosto.com/address/_postcode" 
        data-cart-url="{{cart.url}}" 
        data-log="{{account.is_logged_in}}" 
        data-path="{{cart.checkout_url}}" 
        data-account="{{account.is_logged_in|default(0)}}" 
        data-klarna-method-id="{{klarnaMethodId}}"
        data-best-delivery-time="{% if has_app('expected-delivery') and cart.pluginData.expectedDelivery.bestDelivery %}{{cart.pluginData.expectedDelivery.bestDelivery.expected_time}}{% endif %}"
    >
        {% include 'checkout/steps/step1.twig' %} 
        {% include 'checkout/steps/step2.twig' %} 
        {% include 'checkout/steps/step3.twig' %} 
        {% include 'checkout/steps/step4.twig' %}
    </form>
    </div>