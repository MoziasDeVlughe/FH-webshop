{% if post is empty %}
    {% set postdata = [] %}
{% else %}
    {% set postdata = post %}
{% endif %}

{% if account is not empty %}
    {% set customerData = account.customer %}
    {% set billingData = account.billing.address.postal_code  ? account.billing : [] %}
    {% set shippingData = account.shipping.address.postal_code ? account.shipping : [] %}
    
    {% set postdata = replace_recursive({
        'customer' : customerData,
        'billing' : billingData,
        'shipping' : shippingData
    }, postdata) %}
{% endif %}


