{% if has_app('expected_delivery') and pluginData.expectedDelivery.bestDelivery.id %}
    {% set days = pluginData.expectedDelivery.bestDelivery.days %}
    {% set last_call = pluginData.expectedDelivery.bestDelivery.last_call|date("H:i") %}
    {% set expected_time = pluginData.expectedDelivery.bestDelivery.expected_time|date("d-m") %}
    {% set delivery_time = pluginData.expectedDelivery.bestDelivery.delivery_time|date("H:i") %}
    
    {% set delivery_date_string = 'op [datum]'|t({ "[datum]": pluginData.expectedDelivery.bestDelivery.expected_time|date("d-m") }) %}
    {% if pluginData.expectedDelivery.bestDelivery.days == 0 %}
        {% set delivery_date_string = 'vandaag'|t %}
    {% elseif pluginData.expectedDelivery.bestDelivery.days == 1 %}
        {% set delivery_date_string = 'morgen'|t %}
    {% endif %}

    {% set expected_delivery_notification = "Voor [bestel_tijd] besteld, [leverdatum] voor [levertijd] geleverd"|t({ "[bestel_tijd]": last_call, "[leverdatum]": delivery_date_string, "[levertijd]": delivery_time }) %}
{% endif %}

{% include ['product/'~ code ~ '.twig','product/default.twig'] with {'use_quickview': use_quickview, 'use_share' : use_share } %}
