{# product index #}
{# In this file you determine wich layout should be used for the product page. #}
{# You can choose exciting layouts or build a new one. #}
{# to use a layout simply fill in the name of the document between the double qoutes for the code variable. #}
{# This will search for the file and use that code for the product page, if it doesn't exist it will use the default. #}

{# code options #}
{#  - default #}
{#  - layout-1 #}
{#  - layout-2 #}
{% set code = "product-1" %}

{% set use_quickview    = true %}
{% set use_share        = false %}

{{
    merge_schema({
        "brand" : {
            "@context":"http:\/\/schema.org",
            "@type" : "Thing",
            "name" :specifications['merk']['options']|first.label,
        },
    })
}}


