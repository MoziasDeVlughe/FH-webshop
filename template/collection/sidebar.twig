{% import "macros/default.twig" as macros %}
{% if menus.active.items is not empty or filters is not empty %}
    <div class="collection-menu-buttons visible-xs visible-sm floating-filter-button">
        <div class="row">
            {#<div class="col-xs-6">#}
            {#    {% if menus.active.items is not empty %}#}
            {#        <div class="btn btn-primary btn-block mob-button" data-open="sub-menu">#}
            {#            {{"categorieën"|t}}#}
            {#        </div>#}
            {#    {% endif %}#}
            {#</div>#}
            <div class="col-xs-12">
