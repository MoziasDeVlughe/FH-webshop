<div class="container pb-50">
    <h1>{{"Resultaten voor"|t}}: {{label}}</h1>
    <hr />
    <div class="row">
        <div class="col-md-3 col-md-push-9">
            {% if blog.tags is not empty %}
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4>{{"Andere tags"|t}}</h4>
                    </div>
                    <div class="panel-body">
                        <ul class="list-unstyled">
                            {% for tag in blog.tags %}
                                {% if tag.label != label %}
                                <li><a href="{{tag.url}}">{{tag.label}}</a></li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}
            <a href="/blog" class="btn btn-secondary"><i class="fa fa-chevron-left"></i> {{"Terug naar het overzicht"|t}}</a>
        </div>
        <div class="col-md-9 col-md-pull-3">
            {% include 'blog/postlist.twig' with {'posts' : posts, 'blogpostclass' : 'col-md-6'}  %}
        </div>
    </div>
</div>