<div class="blogpost-list row">
    {% for post in posts|reverse %}
        <div class="blogpost {{blogpostclass}}">
            <a href="{{post.url}}">
                
                <div class="blogpost-header">
                    <div class="blogpost-image" style="background-image: url({{post.image.thumbs.400|replace({'inline':'blogpost'})|image({"w": 555, "h": 250, "c": 1})}})">
                        {% if post.image is null %}
                            <div class="blur">{{get_excerpt(post.content, 1000, 0)}}</div>
                        {% endif %}
                    </div>
                    <div class="blogpost-title">
                        <h2>
                            {{post.title}}
                        </h2>
                        <h4>
                            {{post.subtitle}}<br>
                        </h4>
                            
                        <small class="text-muted">{{post.publish_date|date("d F Y")}}</small>
                    </div>
                </div>
            </a>
        </div>
    {% endfor %}
</div>