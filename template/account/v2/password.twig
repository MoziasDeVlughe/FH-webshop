<div class="container">
    <h1>{{"Wachtwoord wijzigen"|t}}</h1>
    <hr>
    <div class="row">
        <div class="col-xs-12 col-sm-3 col-xl-2 account-menu-sticky">
            {% include 'account/menu.twig' %}
        </div>
        <div class="col-xs-12 col-sm-9 col-xl-10">
            <form method="post">
                <h3>{{"Kies een nieuw wachtwoord"|t}}</h3>
                <label class="control-label" for="account_password">{{"Wachtwoord"|t}}</label>
                <input type="password" class="form-control" id="account_password" name="account[password]" placeholder="{{"Wachtwoord"|t}}">
                <label class="control-label" for="account_password_copy">{{"Wachtwoord kopie"|t}}</label>
                <input type="password" class="form-control" id="account_password_copy" name="account[password_copy]" placeholder="{{"Wachtwoord herhalen"|t}}">
                <button type="submit" class="btn btn-primary">{{"Opslaan"|t}}</button>
            </form>
        </div>
    </div>
</div>