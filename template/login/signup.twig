<div class="container">
    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <i class="fa fa-sign-in-alt"></i> {{"Registreren"|t}}
                </div>
                <div class="panel-body">
                    <form method="post" id="register-form" class="form-validate">
                        <div class="form-group">
                            <label>{{'Aanhef'|t}}</label>
                            <input id="account_is_female" type="hidden" value="" name="customer[is_female]">
                            <div class="radio af">
                                <label for="account_is_female_0">
                                    <input class="phoenix-input" type="radio" name="customer[is_female]" id="account_is_female_0" value="0" {% if postdata.customer.is_female == false %} checked {% endif %} >
                                    <div class="radio-button"></div>
                                    {{'Man'|t}}  
                                </label> 
                            </div>
                            
                            <div class="radio af">
                                <label for="account_is_female_1"> 
                                    <input class="phoenix-input" type="radio" name="customer[is_female]" id="account_is_female_1" value="1" {% if postdata.customer.is_female == true %} checked {% endif %} >
                                    <div class="radio-button"></div>
                                    {{'Vrouw'|t}}
                                </label> 
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="control-label" for="account_first_name">{{"Voornaam"|t}}</label>
                            <div class="validation-container">
                                <input type="text" class="form-control" id="account_first_name" name="account[first_name]" placeholder="{{"Je voornaam"|t}}" data-parsley-required="true" data-parsley-minlength="1">
                            </div>
                            <div class="field-error-container"></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="account_last_name">{{"Achternaam"|t}}</label>
                            <div class="validation-container">
                                <input type="text" class="form-control" id="account_last_name" name="account[last_name]" placeholder="{{"Je achternaam"|t}}" data-parsley-required="true" data-parsley-minlength="1">
                            </div>
                            <div class="field-error-container"></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="account_email">{{"E-mailadres"|t}}</label>
                            <div class="validation-container">
                                <input type="text" class="form-control" id="account_email" name="account[email]" placeholder="{{"Je e-mailadres"|t}}" data-parsley-type="email" data-parsley-required="true" >
                            </div>
                            <div class="field-error-container"></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="account_password">{{"Wachtwoord"|t}}</label>
                            <div class="validation-container">
                                <input type="password" class="form-control" id="account_password" name="account[password]" placeholder="{{"Je wachtwoord"|t}}" data-parsley-required="true" data-parsley-minlength="4">
                            </div>
                            <div class="field-error-container"></div>
                        </div>
                        {% if has_app('re-captcha') %}
                            <div class="form-group">
                                <div class="col-xs-12 col-md-10 form-group text-right">
                                    <input type="hidden" name="whoareyou">
                                    {{call("recaptcha")|first}}
                                </div>
                            </div>
                        {% endif %}
                        <div class="form-group">
                            <div class="row">
                                <div class="col-xs-6">
                                    <a class="btn btn-primary-inverse" href={{url}}>{{"Terug naar inloggen"|t}}</a>
                                </div>
                                <div class="col-xs-6">
                                    <button type="submit" class="btn btn-primary col-xs-12">{{"Registreren"|t}}</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>