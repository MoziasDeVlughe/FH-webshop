<div class="container">
    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <i class="fa fa-question-circle"></i> {{"Wachtwoord opnieuw aanvragen"|t}}
                </div>
                <div class="panel-body">
                    <p>
                        {{"Je ontvangt een e-mail met daarin een link om een nieuw wachtwoord in te stellen."|t}}
                    </p>
                    <form method="post" id="login-form" class="form-validate">
                        <div class="form-group">
                            <label class="control-label" for="account_email">{{"E-mail"|t}}</label>
                            <div class="validation-container">
                                <input type="email" class="form-control" id="account_email" name="account[email]"  value="{{email}}" placeholder="{{"Voer je e-mailadres in"|t}}" data-parsley-type="email" data-parsley-required="true">
                            </div>
                             <div class="field-error-container"></div>
                        </div>
                        <div class="form-group text-center">
                            <div class="row">
                                <div class="col-xs-6">
                                <a class="btn btn-primary-inverse" href={{url}}>{{"Terug naar inloggen"|t}}</a>
                            </div>
                                <div class="col-xs-6">
                                    <input type="submit" class="btn btn-primary col-xs-12" value="{{"Verstuur"|t}}"/>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
