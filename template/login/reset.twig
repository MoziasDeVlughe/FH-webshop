<div class="container">
    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <i class="fa fa-sync"></i> {{"Wachtwoord herstellen"|t}}
                </div>
                <div class="panel-body">
                    <p>
                        {{"Kies hieronder een nieuw wachtwoord. Na het wijzigen bent u direct ingelogd."|t}}
                    </p>
                    <form method="post" id="login-form" class="form-validate">
                        <div class="form-group">
                            <label class="control-label" for="account_email">{{"Wachtwoord"|t}}</label>
                            <div class="validation-container">
                                <input type="password" class="form-control" id="account_password" name="account[password]" placeholder="{{"Wachtwoord"|t}}" data-parsley-type="password" data-parsley-required="true">
                            </div>
                             <div class="field-error-container"></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="account_email">{{"Wachtwoord kopie"|t}}</label>
                            <div class="validation-container">
                                <input type="password" class="form-control" id="account_password_copy" name="account[password_copy]" placeholder="{{"Wachtwoord herhalen"|t}}" data-parsley-type="password" data-parsley-required="true">
                            </div>
                             <div class="field-error-container"></div>
                        </div>
                        <div class="form-group text-center">
                            <div class="row">
                                <div class="col-xs-6">
                                <a class="btn btn-link" href={{url}}>{{"Terug naar inloggen"|t}}</a>
                            </div>
                                <div class="col-xs-6">
                                    <input type="submit" class="btn btn-success col-xs-12" value="{{"Verstuur"|t}}"/>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>