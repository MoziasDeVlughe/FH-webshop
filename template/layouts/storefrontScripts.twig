        const [smallBusinessValue, setSmallBusinessValue] = useState(false);
        
        const handleSignUp = async (e) => {
            e.preventDefault();
            try {
                setServerError(null);
                if ($(e.target).parsley().isValid()) {
                    setIsSubmitting(true);
                    const formData = new FormData(e.target);
                    const body = Object.fromEntries(formData);
                    
                    const data = new URLSearchParams();
                    for (const pair of formData) {
                        data.append(pair[0], pair[1]);
                    }

                    
                    const response = await fetch('/form/aanvraag/', {
                        method: "POST",
                        body: data,
                        headers: {
                            accept: 'application/json',
                        }
                    });
                    const responseData = await response.json();
                    
                    
                    if (response.ok && responseData?.content?.success) {
                        setSubmitSuccess(true);
                    } else {
                        setServerError('Controleer de velden.');
                    }
                }
            } catch (e) {
                setServerError(getErrorMessage(e));
                setIsSubmitting(false);
            }
        };
        
        const handleChangeCountry = e => {
            setCountryValue(e.target.value);
