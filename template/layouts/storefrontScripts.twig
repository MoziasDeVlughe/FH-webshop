                            <strong>
                                ${product.name}
                            </strong>
                        </div>
                    </a>
                </div>
                <div class="product-info">
                    
                    <div class="product-info-description hidden-xs list-visible">
                        <a data-af-href="${product.url}" class="product-name list-visible" title="${product.name}">
