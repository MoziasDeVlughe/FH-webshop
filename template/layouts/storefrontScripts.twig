                                >
                                    {{'Log in'|t}}
                                </button>
                        `}
                        ${!isSubmitted && html`
                            <p>{{'Voer je e-mailadres in en je ontvangt van ons een e-mail om je nieuwe wachtwoord in te stellen.'|t}}</p>
                            <form id="sign-in-form" class="form-validate" onSubmit="${handleRequeestPasswordReset}">
                                ${serverError && html`<p class="text-danger">${serverError}</p>`}
