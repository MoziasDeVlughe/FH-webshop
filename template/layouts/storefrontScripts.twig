                    <${CouponForm} coupons="${coupons}" />
                    // <${PayPalButton} options="${paypalOptions}" />
                    
                    <a class="btn btn-primary btn-block mt-16" href="${checkoutUrl}" title="{{'Verder met bestellen'|t}}">
                        {{'Verder met bestellen'|t}}
