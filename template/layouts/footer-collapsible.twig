{# type: layout #}
{% import 'macros/displays.twig' as af_displays %}

{#{% set newsletter = pluginData.newsletter[<nieuwsbrief id>] %}#}

<footer class="footer-collapsible">
    <section class="contact-footer">
        <div class="container">
            <div class="contact-container">
                <div class="contact-titles">
                    {{blocks.contact_title.content|replace({
                        '<strong>': '<span class="contact-title">',
                        '</strong>': '</span>',
                        '<em>': '<span class="contact-time">',
                        '</em>': '</span>',
                    })}}
                </div>
                <div class="contact-labels">
                    {% for label in blocks %}
                        {% if "contact_table" in label.identifier %}
                            {% set cleaned = label.content|replace({
                                '</td>': '',
                                '<tr>': '',
                                '\n': '',
                                '\t': '',
                                '<table style="font-size: 14px;">': '',
                                '</table>': '',
                                '<tbody>': '',
                                '</tbody>': ''
                            })|trim %}
                            {% set rawRows = cleaned | split('</tr>') %}
                            {% set tableData = {} %}
                            {% for row in rawRows %}
                                {% if row is not empty %}
                                    {% set cols = row | split('<td>') %}
                                    {% if cols|length == 3 %}
                                        {% set key = cols[1]|trim|lower %}
                                        {% set value = cols[2]|trim %}
                                            {% if key == 'icon' %}
                                                {% set value = value|replace({
                                                    '&lt;': '<',
                                                    '&gt;': '>',
                                                    '&quot;': '"',
                                                    '&amp;': '&'
                                                }) %}
                                            {% endif %}
                                        {% set tableData = tableData | merge({ (key): value }) %}
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                            
                            <div class="contact-labels">
                                <a class="contact-label" {# href="tel:{{tableData.tel}}" #}>
                                    <i data-lucide="phone" class="size-28"></i>
                                    <div>
                                        <span>
                                            {{'Telefonisch'|t}}
                                        </span>
                                        <p>
                                            {{'Bel naar'|t}} {{tableData.tel}}
                                        </p>
                                    </div>
                                    <i data-lucide="chevron-right" class="size-32 ml-auto"></i>
                                </a>
                            </div>
                            <div class="contact-labels">
                                <a class="contact-label" {# href="https://web.whatsapp.com/send?phone={{tableData.tel|replace({'+': ''})}}" #}>
                                    <i class="fa-brands fa-whatsapp"></i>
                                    <div>
                                        <span>
                                            {{'Whatsapp'|t}}
                                        </span>
                                        <p>
                                            {{'App naar'|t}} {{tableData.tel}}
                                        </p>
                                    </div>
                                    <i data-lucide="chevron-right" class="size-32 ml-auto"></i>
                                </a>
                            </div>
                            <div class="contact-labels">
                                <a class="contact-label" {# href="mailto:{{tableData.mail}}" #}>
                                    <i data-lucide="mail" class="size-28"></i>
                                    <div>
                                        <span>
                                            {{'Email'|t}}
                                        </span>
                                        <p>
                                            {{'Mail naar'|t}} {{tableData.mail}}
                                        </p>
                                    </div>
                                    <i data-lucide="chevron-right" class="size-32 ml-auto"></i>
                                </a>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
    <section class="top-footer">
        <div class="container">
            <div class="top-footer-inner">
                {##}
                {#USPS are dynamically loaded from tekstblokken. make sure the name contains usps and it will appear in the right places#}
                {##}
                {% for usp in blocks %}
                    {% if "usps" in usp.identifier %}
                        <span class="usps-item">
                            {{usp.content}}
                        </span>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>
    <section class="main-footer">
        <div class="container">
            <div class="d-flex flex-wrap mx-n15"> 
            {% set footer_column_counter = 1 %}
            
                <div class="flex-100 flex-md-25 px-15">
                    <div 
                        class="h3 footer-column-heading collapsed" 
                        data-toggle="collapse" 
                        data-target="#footer-column-{{footer_column_counter}}" 
                        aria-expanded="false"
                    >
                        {{menus.footer.name}}
                        <div class="collapsible-icon"></div>
                    </div>
                    <div class="collapse" id="footer-column-{{footer_column_counter}}{% set footer_column_counter = footer_column_counter + 1 %}">
                        <ul class="list-unstyled">
                            {% for menuitem in menus.footer.items %}
                                <li class="{% if menuitem.active %}active{% endif %}">
                                    <a href="{{menuitem.url}}" class="">{{menuitem.label}}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                <div class="flex-100 flex-md-25 px-15">
                    <div
                        class="h3 footer-column-heading collapsed" 
                        data-toggle="collapse" 
                        data-target="#footer-column-{{footer_column_counter}}" 
                        aria-expanded="false"
                    >
                        {{"Contact"|t}}
                        <div class="collapsible-icon"></div>
                    </div>
                    <div class="collapse" id="footer-column-{{footer_column_counter}}{% set footer_column_counter = footer_column_counter + 1 %}">
                        <address>
                            {{blocks.contact_info.content}}
                        </address>
                    </div>
                </div>
                <div class="flex-100 flex-md-25 px-15 open-hours-table">
                    <div
                        class="h3 footer-column-heading collapsed" 
                        data-toggle="collapse" 
                        data-target="#footer-column-{{footer_column_counter}}" 
                        aria-expanded="false"
                    >
                        {{"Openingstijden"|t}}
                        <div class="collapsible-icon"></div>
                    </div>
                    <div class="collapse" id="footer-column-{{footer_column_counter}}{% set footer_column_counter = footer_column_counter + 1 %}">
                        {{blocks.open_hours.content}}
                    </div>
                </div>
                <div class="flex-100 flex-md-25 px-15">
                    <div class="h3">
                        {{"Nieuwsbrief"|t}}
                        <div class="collapsible-icon"></div>
                    </div>
                    <form method="post" name="subscribe" action="" >
                        <div class="form-group">
                            <p class="hidden-xs">{{'Blijf op de hoogte van acties en het laatste nieuws door je aan te melden voor de nieuwsbrief.'|t}}</p>
                            <div class="input-group">
                                <input type="email" name="email" id="mail" class="form-control" placeholder="{{'e-mailadres'|t}}" aria-label="{{'E-mailadres'|t}}">
                                <span class="input-group-btn">
                                    <button type="submit" class="btn btn-primary">{{'Verstuur'|t}}</button>
                                </span>
                            </div>
                        </div>
                    </form>
                    {#{% if has_app('newsletter') %}#}
                    {#    {% if newsletter is not defined %}#}
                    {#        {% set newsletter = pluginData.newsletter|first %}       #}
                    {#    {% endif %}    #}
                        {#<form method="post" name="subscribe" action="/newsletter/subscribe/5" >#}
                        {#    <div class="form-group">#}
                        {#        <p class="hidden-xs">{{'Blijf op de hoogte van acties en het laatste nieuws door je aan te melden voor de nieuwsbrief.'|t}}</p>#}
                        {#        <div class="input-group">#}
                        {#            <input type="email" name="email" id="mail" class="form-control" placeholder="{{'e-mailadres'|t}}">#}
                        {#            <span class="input-group-btn">#}
                        {#                <button type="submit" class="btn btn-success">{{'Verstuur'|t}}</button>#}
                        {#            </span>#}
                        {#        </div>#}
                        {#    </div>#}
                        {#</form>#}
                    {#{% endif %}#}
                </div>
            </div>
        </div>
    </section>
    {#<section class="second-footer">#}
    {#    <div class="container text-center">#}
    {#        <ul class="mb-0 list-inline">#}
    {#            {% for method in properties.payment_methods if method.icon %}#}
    {#                <li>#}
    {#                    <img data-src="{{method.icon.filename|image({"h": 25})}}" alt="{{method.name}}" class="lazyload">#}
    {#                </li>#}
    {#            {% endfor %}#}
    {#        </ul>#}
    {#    </div>#}
    {#</section>#}
