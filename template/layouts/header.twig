{# type: layout #}
{% import 'macros/sliders.twig' as af_sliders %}
{% import 'macros/displays.twig' as af_displays %}
{% import 'macros/menus.twig' as af_menus %}

{# Tijdelijke transitie-melding (tekstblok: extra_banner). Site-breed, niet op checkout. #}
{% if blocks.extra_banner.content is not empty %}
    <div class="extra-banner" role="status">
        <div class="container">
            <div class="extra-banner__inner">
                <i data-lucide="info" class="extra-banner__icon size-18"></i>
                <div class="extra-banner__text">{{ blocks.extra_banner.content }}</div>
            </div>
        </div>
    </div>
{% endif %}

