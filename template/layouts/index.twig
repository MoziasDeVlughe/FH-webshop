{# type: layout #}
{% extends 'config.twig' %}
{% block configProvider %}

    {% set container_class = 'container' %}
    
    <!DOCTYPE html>
    <html lang="nl" dir="ltr">
        <head>
            <meta charset="utf-8">
            <meta http-equiv="X-UA-Compatible" content="IE=edge">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            {%  if seo_robots == "" %}
                {% set robots = "index, follow" %}
            {% else %}
                {% set robots = seo_robots %}
            {% endif %}
            {% if type == 'cart' or type == 'checkout' or type == 'search' or is_error or model.specifications['onderhoud'] is not empty %}
               {% set robots = "noindex, follow"  %}
            {% endif %}
            
            {% set h1 = title %}
            {% if has_app('filters')%}
                {% set clean_filter = null %}
                {% for filter in active_filters  if clean_filter == null %}
                   {% if filter.is_clean_url %}
                      {% set clean_filter = filter %}
                    {% endif %}
                {% endfor %}
                
                {# to make sure we dont have duplicate content only show the content on a page without clean filters.#}
                {% if clean_filter is not null %} 
                {# its a clean url so we want to preppend the h1 with the filter#}
                    {% set h1 = clean_filter.clean_url_label ~' ' ~ h1|slice(0,1)|lower ~ h1|slice(1) %}
                {% endif%}
                {# always make sure that the h1 is ucfirst #}
                {% set  h1 = h1|slice(0,1)|capitalize ~ h1|slice(1) %}
            {% endif %}
            {% set h1 = h1|e %}
            
            {% set sseo_title = seo_title %}
            {% set sseo_description = seo_description %}
            
            {% if sseo_title is empty %}
                {% set sseo_title = h1 ~ " - " ~ properties.name %}
            {% endif %}
            
            {% if sseo_description is empty %}
                {% set sseo_description = h1 ~ " - " ~ properties.name %}
            {% endif %}
            
            {% set og_type = "website" %}
            {% if type == 'product' %}
                {% set og_type = "article" %}
            {% endif %}
            
            {% set og_img = properties.logo|image %}
            {% if type == 'product' %}
                {% set og_img = og.image.filename|image %}
            {% endif %}
            
            <meta name="robots" content="{{robots}}">
            <meta name="title" content="{{sseo_title}}">
            <meta name="keywords" content="{{seo_keywords}}">
            <meta name="description" content="{{sseo_description}}">
            
            <meta property="og:type" content="{{og_type}}">
            <meta property="og:url" content="{{current_url}}">
            <meta property="og:title" content="{{sseo_title}}">
            <meta property="og:image" content="{{og_img}}">
            <meta property="og:description" content="{{sseo_description}}">
            <meta property="og:site_name" content="{{properties.name}}">
            <meta property="og:locale" content="{{language}}">
            
            <meta name="twitter:card" content="summary">
            <meta name="twitter:url" content="{{current_url}}">
            <meta name="twitter:title" content="{{sseo_title}}">
            <meta name="twitter:description" content="{{sseo_description}}">
            <meta name="twitter:image" content="{{og_img}}">
            
            {% if(menu_item.pagination is not null) %}
                {% set canonical = menu_item.pagination.buttons|first.link_clean %}
                
                {% if menu_item.pagination.previous_page_link_clean is not empty %}
                    <link rel="prev" href="{{menu_item.pagination.previous_page_link_clean}}" />
                {% endif %}
                
                {% if menu_item.pagination.next_page_link_clean is not empty %}
                    <link rel="next" href="{{menu_item.pagination.next_page_link_clean}}" />
                {% endif %}
            {% endif %}
            
            
            {% if active_filters is not empty %}
                {% for page in menu_item.pagination.buttons %}
                    {% if page.active == true %}
                        {% set canonical = page.link_clean %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            
            
            {% if canonical is not empty %}<link rel="canonical" href="{{canonical}}" />{% endif %}
            <title>{{sseo_title}}</title>
            
            <link rel="icon" type="image/png" href="{{image('/image/4838311490-android-chrome-192x192.png')|image}}" />
            <link rel="icon" href="{{home_url}}favicon.ico" sizes="any">
            <meta name="apple-mobile-web-app-title" content="{{properties.name}}">
            <meta name="application-name" content="{{properties.name}}">
            <meta name="msapplication-TileColor" content="#064370">
            <meta name="theme-color" content="#064370">
            
            <link rel="dns-prefetch" href="https://connect.facebook.net">
            {#<link rel="dns-prefetch" href="https://afosto-cdn-01.afosto.com">#}
            <link rel="dns-prefetch" href="//cdnjs.cloudflare.com">
            
            <script src="https://kit.fontawesome.com/b3217c1569.js" crossorigin="anonymous"></script>
            
            <link
              rel="stylesheet"
              href="https://unpkg.com/lucide-static@0.518.0/font/lucide.css"
            />
            
            <link
              rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
            />
            <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
            
            <link rel="preconnect" href="https://staticxx.facebook.com" crossorigin>
            <link rel="preconnect" href="https://connect.facebook.net" crossorigin>
            <link rel="preconnect" href="https://www.google-analytics.com" crossorigin>
           {% if type == 'user' %}
                <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.0/dist/JsBarcode.all.min.js" type="text/javascript"></script>
            {% endif %}
            {{merge_schema({
                "1":{
                "@type": "Organization",
                "sameAs" : [
                  "https://www.facebook.com/afosto",
                  "https://twitter.com/afosto",
                  "https://plus.google.com/+Afosto"
                ]
              }})
            }}
            
            {% if is_home %}
              {{replace_schema({0 : null })  }}
            {% endif %}
            
            {% if type == 'product' %}
                <link
                    rel="stylesheet"
                    href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css"
                />
            {% endif %}
            
            {{minify(["/scss/main.scss"], 'stylesheet')}}
            {#{{minify(["/scss/main.scss"], 'stylesheet')|replace({ '">': '" media="print" onload="this.media=`all`; this.onload=null;">' })}}#}
            
            
            {#<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.0/css/all.css" integrity="sha384-lZN37f5QGtY3VHgisS14W3ExzMWZxybE1SJSEsQp9S+oqd12jhcu+A56Ebc1zFSJ" crossorigin="anonymous">#}
            <!-- Begin Cookie Consent plugin by Silktide - http://silktide.com/cookieconsent -->
            
            <!-- End Cookie Consent plugin -->
            <!-- Global site tag (gtag.js) - Google Analytics -->

        </head>

        <body class="type-{{type}}" data-af-currency="{{properties.currency_symbol}}" data-af-currency-iso="{{properties.currency}}">
            <div id="fb-root"></div>
            {#{% if type != 'checkout' or type != 'cart' %}#}
            {#    <script>#}
            {#        (function(d, s, id) {#}
            {#          var js, fjs = d.getElementsByTagName(s)[0];#}
            {#          if (d.getElementById(id)) return;#}
            {#          js = d.createElement(s); js.id = id; js.defer=true;#}
            {#          js.src = "//connect.facebook.net/nl_NL/sdk.js#xfbml=1&version=v2.7&appId=1876097765947515";#}
            {#          fjs.parentNode.insertBefore(js, fjs);#}
            {#        }(document, 'script', 'facebook-jssdk'));#}
            {#    </script>#}
            {#{% endif %}#}
            
            {% include 'layouts/base.twig' %}
            
            {#<script data-search-pseudo-elements defer src="https://use.fontawesome.com/releases/v5.7.0/js/all.js" integrity="sha384-qD/MNBVMm3hVYCbRTSOW130+CWeRIKbpot9/gR1BHkd7sIct4QKhT1hOPd+2hO8K" crossorigin="anonymous"></script>#}
            <script>
                window.lazySizesConfig = window.lazySizesConfig || {};
                window.lazySizesConfig.init = false;
            </script>
            
            <script src="https://cdn.jsdelivr.net/npm/instantsearch.js@4.8.3/dist/instantsearch.production.min.js" integrity="sha256-LAGhRRdtVoD6RLo2qDQsU2mp+XVSciKRC8XPOBWmofM=" crossorigin="anonymous"></script>
