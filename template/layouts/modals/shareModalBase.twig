<div class="modal fade" id="share-modal" tabindex="-1" role="dialog" aria-labelledby="social-modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <span class="modal-title h4" id="social-modal">{{'Leuk dat je dit artikel wilt delen!'|t}}</span>
            </div>
            <div class="modal-body text-center">
                <div class="row">
                    <div class="col-md-4 col-xs-3">
                        <a data-af-href="https://www.facebook.com/sharer/sharer.php?u={{url}}&t=" rel="noopener noreferrer" target="_blank" title="{{"Share on Facebook"|t}}" >
                            {{'Facebook'|t}}
                        </a>
                    </div>
                    <div class="col-md-4 col-xs-3">
                        <a data-af-href="https://www.facebook.com/sharer/sharer.php?u={{url}}&t=" rel="noopener noreferrer" target="_blank" title="{{"Share on Pinterest"|t}}" >
                            {{'Pinterest'|t}}
                        </a>
                    </div>
                    <div class="col-md-4 visible-xs visible-sm col-xs-3">
                        <a data-af-href="whatsapp://send?text={{url}}">
                            {{'WhatsApp'|t}}
                        </a>
                    </div>
                    <div class="col-md-4 col-xs-3">
                        <a data-af-href="mailto:?subject=&body={{url}}" rel="noopener noreferrer" target="_self" title="{{"Send email"|t}}">
                            {{'Email'|t}}
                        </a>
                    </div>
                </div>
            </div>
            <div class="modal-footer text-center">
               {{' Kopieer deze link om op je website te plaatsen of om te gebruiken in een bericht'|t}}
                <div class="form-group">
                    <div class="input-group">
                        <input class="form-control" value="{{url}}" id="copy-field" data-clipboard-text="{{url}}">
                        <div class="input-group-btn">
                            <button type="button" class="copy-to-clipboard btn btn-primary" data-clipboard-target="#copy-field" data-toggle="tooltip" data-placement="bottom" title="{{'Gekopieerd!'|t}}">{{'Kopieer'|t}}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>