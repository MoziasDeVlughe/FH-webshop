{# type: layout #}
{# Styling staat in scss/_florian-redesign.scss (gescopet onder .fh-footer). #}

<footer class="fh-footer">
    <div class="fh-footer-wrap">
        <div class="fh-footer-top">

            {# --- merk + intro --- #}
            <div>
                <div class="fh-footer-brand">
                    {% if properties.logo %}
                        <a href="{{ home_url }}"><img src="{{ properties.logo|image }}" alt="{{ properties.name }}"></a>
                    {% else %}
                        <span class="fh-footer-name">{{ properties.name }}</span>
                    {% endif %}
                </div>
                <p class="fh-footer-about">Pure, natuurlijke paardenvoeding voor een gezond rantsoen. Voer je paard zoals de natuur het bedoeld heeft.</p>
            </div>

            {# --- contact --- #}
            <div>
                <h4>{{"Contact"|t}}</h4>
                <address style="font-style:normal;">
                    <div class="fh-contact-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        <span>Veldhoven 15A<br>5081 NK Hilvarenbeek</span>
                    </div>
                    <div class="fh-contact-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5c0 9 6 15 15 15l0-4-4-1-2 2c-3-1.5-5.5-4-7-7l2-2-1-4H4z"/></svg>
                        <a href="tel:0850604129">085 - 060 41 29</a>
                    </div>
                    <div class="fh-contact-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.5 8.5 0 0 1-12.2 7.6L3 21l1.9-5.8A8.5 8.5 0 1 1 21 11.5z"/></svg>
                        <a href="https://wa.me/31850604129">Florian Advies-app</a>
                    </div>
                    <div class="fh-contact-row">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        <a href="/verkooppunten/">Lokale verkooppunten</a>
                    </div>
                </address>
            </div>

            {# --- navigatie (footer-menu) --- #}
            <div>
                <h4>{{"Navigeren"|t}}</h4>
                <ul>
                    {% for menuitem in menus.footer.items %}
                        <li{% if menuitem.active %} class="active"{% endif %}>
                            <a href="{{menuitem.url}}">{{menuitem.label}}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            {# --- nieuwsbrief --- #}
            <div class="fh-news">
                <h4>{{"Nieuwsbrief"|t}}</h4>
                <p>Blijf op de hoogte van nieuwe producten, acties en gezonde-voeding-tips.</p>
                <form method="post" name="subscribe" action="">
                    <input type="email" name="email" id="mail" placeholder="{{'Jouw e-mailadres'|t}}" aria-label="{{'E-mailadres'|t}}">
                    <button type="submit">{{'Inschrijven'|t}}</button>
                </form>
            </div>
        </div>

        {# --- betaalmethodes --- #}
        {% if properties.payment_methods is not empty %}
            <div class="fh-footer-pay">
                <ul>
                    {% for method in properties.payment_methods if method.icon %}
                        <li><img data-src="{{method.icon.thumbs.100|image({"h": 25})}}" alt="{{method.name}}" class="lazyload"></li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# --- onderbalk --- #}
        <div class="fh-footer-bottom">
            <span>&copy; {{"now"|date('Y')}} {{properties.name}} — Back to Basic</span>
            <a href="https://afosto.com" target="_blank" rel="noopener" class="afosto" title="this site is powered by Afosto">
